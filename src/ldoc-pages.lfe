;;;; Pure identity, metadata, and URI helpers for selected Markdown pages.

(defmodule ldoc-pages
  "Canonicalise selected logical documentation paths and derive stable routes."
  (export (prepare 2) (prepare-graph 1) (route 1) (canonical-path 1)))

(defspec (prepare 2)
  ([(term) (term)] (UNION (tuple 'ok (list)) (tuple 'error (term)))))
(defspec (route 1)
  ([(binary)] (binary)))
(defspec (canonical-path 1)
  ([(binary)] (UNION (tuple 'ok (binary)) 'error)))

(defun canonical-path (path)
  "Validate a project-relative logical Markdown identity and NFC-normalise it."
  (if (andalso (is_binary path) (> (byte_size path) 0))
      (case (unicode:characters_to_nfc_binary path)
        (normal (when (is_binary normal))
         (if (valid-path? normal) `#(ok ,normal) 'error))
        (_ 'error))
      'error))

(defun valid-path? (path)
  (andalso (valid-utf8? path)
   (andalso (not (has-byte? path 92))
   (andalso (not (has-byte? path 63))
   (andalso (not (has-byte? path 35))
   (andalso (not (=:= (binary:at path 0) 47))
   (andalso (not (drive-path? path))
            (valid-components? (binary:split path #b("/") (list 'global))))))))))

(defun has-byte? (value byte)
  (has-byte-at? value byte 0))
(defun has-byte-at? (value byte pos)
  (if (>= pos (byte_size value)) 'false
      (or (=:= (binary:at value pos) byte)
          (has-byte-at? value byte (+ pos 1)))))

(defun drive-path? (path)
  (andalso (> (byte_size path) 1)
           (andalso (=:= (binary:at path 1) 58)
                    (let ((c (binary:at path 0)))
                      (or (andalso (>= c 65) (=< c 90))
                          (andalso (>= c 97) (=< c 122)))))))
(defun valid-components? (parts)
  (case parts
    (() 'false)
    ((cons part rest)
     (andalso (> (byte_size part) 0)
      (andalso (not (or (=:= part #b(".")) (=:= part #b(".."))))
               (andalso (not (has-control? part 0))
                        (if (=:= rest ()) (=:= (filename:extension part) #b(".md"))
                            (valid-components? rest))))))
    (_ 'false)))
(defun has-control? (path pos)
  (if (>= pos (byte_size path)) 'false
      (let ((c (binary:at path pos)))
        (or (or (< c 32) (=:= c 127)) (has-control? path (+ pos 1))))))
(defun valid-utf8? (value)
  (case (unicode:characters_to_binary value 'utf8 'utf8)
    (binary (when (is_binary binary)) 'true)
    (_ 'false)))

(defun route (path)
  "Return the flat, path-derived filename for a canonical logical path."
  (iolist_to_binary (list #b("p-")
      (binary:encode_hex (crypto:hash 'sha256 path) 'uppercase)
      #b(".html"))))

(defun prepare (pages overview-path)
  "Validate ordered page metadata and reject canonical identity collisions."
  (case (canonical-path overview-path)
    ('error '#(error invalid_options))
    (`#(ok ,overview)
     (case (prepare-pages pages overview #m() '())
       (`#(ok ,prepared) `#(ok ,(lists:reverse prepared)))
       (`#(error ,reason) `#(error ,reason))))))
(defun prepare-pages (pages overview seen reversed)
  (case pages
    (() `#(ok ,reversed))
    ((cons page rest)
     (case (prepare-page page)
       ('error '#(error invalid_options))
       (canonical
        (let ((path (maps:get 'path canonical)))
          (if (or (=:= path overview) (maps:is_key path seen))
              '#(error invalid_options)
              (prepare-pages rest overview (maps:put path 'true seen)
                             (cons canonical reversed)))))))
    (_ '#(error invalid_options))))
(defun prepare-page (page)
  (if (andalso (is_map page)
      (andalso (required-optional? page '(path body) '(title))
      (andalso (is_binary (maps:get 'body page))
      (andalso (valid-utf8? (maps:get 'body page))
               (valid-title? page)))))
      (case (canonical-path (maps:get 'path page))
        (`#(ok ,path)
         (let ((base `#m(path ,path body ,(maps:get 'body page))))
           (case (maps:find 'title page)
             (`#(ok ,title) (maps:put 'title title base))
             (_ base))))
        (_ 'error))
      'error))
(defun required-optional? (map required optional)
  (andalso (lists:all (lambda (key) (maps:is_key key map)) required)
           (lists:all (lambda (key) (lists:member key (lists:append required optional)))
                      (maps:keys map))))
(defun valid-title? (page)
  (case (maps:find 'title page)
    ('error 'true)
    (`#(ok ,title)
     (andalso (is_binary title)
      (andalso (valid-utf8? title)
       (andalso (> (byte_size title) 0)
                (not (=:= (string:trim title) #b()))))))))

(defun prepare-graph (documents)
  "Allocate page-wide heading IDs, then resolve all selected local links."
  (case (index-documents documents #m() #m())
    (`#(error ,reason) `#(error ,reason))
    (`#(ok ,indexed)
     (resolve-documents documents indexed #m()))))

(defun index-documents (documents seen indexed)
  (case documents
    (() `#(ok ,indexed))
    ((cons doc rest)
     (let* ((path (maps:get 'path doc))
            (scan (scan-document-blocks
                    (maps:get 'blocks doc (list (maps:get 'body doc)))))
            (heading-result (allocate-headings (maps:get 'headings scan) #m() '())))
       (case heading-result
         (`#(,ids ,slug-index)
          (if (maps:is_key path seen)
              '#(error invalid_options)
              (index-documents rest (maps:put path 'true seen)
                (maps:put path `#m(scan ,scan ids ,ids slug-index ,slug-index
                                    route ,(maps:get 'route doc (route path))) indexed)))))))
    (_ '#(error invalid_options))))

(defun scan-document-blocks (blocks)
  (let ((scans (lists:map #'ldoc-markup:scan/1 blocks)))
    `#m(headings ,(lists:append (lists:map (lambda (scan) (maps:get 'headings scan)) scans))
        links ,(lists:append (lists:map (lambda (scan) (maps:get 'links scan)) scans)))))

(defun allocate-headings (headings used reversed)
  (case headings
    (() `#(,(lists:reverse reversed) ,used))
    ((cons heading rest)
     (let* ((label (element 2 heading))
            (base (slugify label))
            (slug (unused-slug base used 0)))
       (allocate-headings rest (maps:put slug 'true used)
                          (cons (iolist_to_binary (list #b("h-") slug)) reversed))))
    (_ `#(() ,used))))

(defun unused-slug (base used count)
  (let ((candidate (if (=:= count 0) base
                       (iolist_to_binary (list base #b("-")
                                                 (integer_to_binary count))))))
    (if (maps:is_key candidate used)
        (unused-slug base used (+ count 1))
        candidate)))

(defun slugify (label)
  (let* ((normal (unicode:characters_to_nfc_binary label))
         (lower (string:lowercase (unicode:characters_to_list normal)))
         (chars (slug-chars lower '() 'false)))
    (case chars
      (() #b("section"))
      (values (unicode:characters_to_binary values 'unicode 'utf8)))))
(defun slug-chars (chars reversed pending-space)
  (case chars
    (() (trim-slug-hyphens (lists:reverse reversed)))
    ((cons c rest)
     (cond
       ((or (lists:member c '(32 9 10 13)) (unicode-whitespace? c))
        (slug-chars rest reversed (not (=:= reversed ()))))
       ((or (andalso (>= c 48) (=< c 57))
            (andalso (>= c 97) (=< c 122))
            (or (=:= c 95) (=:= c 45))
            (unicode-slug-character? c))
        (let ((prefix (if (andalso pending-space
                                 (not (=:= (hd reversed) 45))) (cons 45 reversed) reversed)))
          (slug-chars rest (cons c prefix) 'false)))
       ('true (slug-chars rest reversed pending-space))))))
(defun unicode-slug-character? (c)
  (case (re:run (unicode:characters_to_binary (list c) 'unicode 'utf8)
                #b("^[\\p{L}\\p{N}\\p{M}]$") (list 'unicode))
    (`#(match ,_) 'true)
    (_ 'false)))
(defun unicode-whitespace? (c)
  (case (re:run (unicode:characters_to_binary (list c) 'unicode 'utf8)
                #b("^\\s$") (list 'unicode 'ucp))
    (`#(match ,_) 'true)
    (_ 'false)))
(defun trim-slug-hyphens (chars)
  (case chars
    ((cons 45 rest) (trim-slug-hyphens rest))
    (_ (trim-slug-hyphens-right chars))))
(defun trim-slug-hyphens-right (chars)
  (case (lists:reverse chars)
    ((cons 45 rest) (trim-slug-hyphens-right (lists:reverse rest)))
    (_ chars)))

(defun resolve-documents (documents indexed contexts)
  (case documents
    (() `#(ok ,contexts))
    ((cons doc rest)
     (let* ((path (maps:get 'path doc))
            (data (maps:get path indexed))
            (links (maps:get 'links (maps:get 'scan data))))
       (case (resolve-links links path indexed (maps:get 'slug-index data) #m())
         (`#(error ,error) `#(error ,error))
         (`#(ok ,resolved)
          (let ((context `#m(headings ,(maps:get 'ids data) links ,resolved)))
            (resolve-documents rest indexed (maps:put path context contexts)))))))
    (_ '#(error invalid_options))))

(defun resolve-links (links document indexed current-slugs resolved)
  (case links
    (() `#(ok ,resolved))
    ((cons href rest)
     (case (resolve-href href document indexed current-slugs)
       ('external (resolve-links rest document indexed current-slugs resolved))
       ('plain (resolve-links rest document indexed current-slugs resolved))
       (`#(ok ,target)
        (resolve-links rest document indexed current-slugs (maps:put href target resolved)))
       (`#(error ,reason)
        `#(error #(documentation_link #m(document ,document href ,href reason ,reason))))))
    (_ `#(ok ,resolved))))

(defun resolve-href (href document indexed current-slugs)
  (case (uri_string:parse href)
    (parsed (when (is_map parsed))
     (case (maps:get 'scheme parsed #b())
       (scheme (when (> (byte_size scheme) 0))
        (if (safe-absolute? parsed) 'external 'plain))
       (_ (resolve-local-href href document indexed current-slugs))))
    (_ (if (looks-absolute? href) 'plain (invalid-local 'malformed_uri)))))

(defun looks-absolute? (href)
  (case (binary:match href #b(":"))
    (`#(,position ,1)
     (andalso (> position 0) (valid-scheme? href 0 position)))
    (_ 'false)))
(defun valid-scheme? (value pos end)
  (if (>= pos end) 'true
    (let ((byte (binary:at value pos)))
      (if (if (=:= pos 0) (alpha-byte? byte) (scheme-byte? byte))
          (valid-scheme? value (+ pos 1) end)
          'false))))
(defun alpha-byte? (byte)
  (or (andalso (>= byte 65) (=< byte 90))
      (andalso (>= byte 97) (=< byte 122))))
(defun scheme-byte? (byte)
  (or (alpha-byte? byte)
    (or (andalso (>= byte 48) (=< byte 57))
      (or (=:= byte 43) (or (=:= byte 45) (=:= byte 46))))))

(defun safe-absolute? (parsed)
  (let ((scheme (string:lowercase (binary_to_list (maps:get 'scheme parsed #b())))))
    (or (andalso (or (=:= scheme "http") (=:= scheme "https"))
                 (is_binary (maps:get 'host parsed #b())))
        (andalso (=:= scheme "mailto") (is_binary (maps:get 'path parsed #b()))))))

(defun resolve-local-href (href document indexed current-slugs)
  (let* ((path (hd (binary:split href #b("#") (list 'global))))
         (query-parts (binary:split path #b("?") (list 'global)))
         (path-only (hd query-parts))
    (decoded-path (decode-component path-only)))
    (if (andalso (> (byte_size path) 0) (not (decoded-markdown-path? decoded-path path-only)))
        'plain
        (if (not (=:= (binary:match href #b("?")) 'nomatch))
            (invalid-local 'query_not_supported)
            (case (binary:split href #b("#") (list 'global))
              ((cons raw-path ())
               (resolve-local-parts raw-path #b() href document indexed current-slugs))
              ((cons raw-path (cons raw-fragment ()))
               (resolve-local-parts raw-path raw-fragment href document indexed current-slugs))
              (_ (invalid-local 'malformed_uri)))))))

(defun decoded-markdown-path? (decoded raw)
  (case decoded
    (`#(ok ,path) (ends-md? path))
    (`#(error ,_detail) (ends-md? raw))))

(defun resolve-local-parts (raw-path raw-fragment href document indexed current-slugs)
  (case (decode-component raw-path)
    (`#(error ,detail) (invalid-local detail))
    (`#(ok ,decoded-path)
     (case (decode-component raw-fragment)
       (`#(error ,detail) (invalid-local detail))
       (`#(ok ,decoded-fragment)
        (if (or (has-control? decoded-path 0) (has-control? decoded-fragment 0))
            (invalid-local 'forbidden_character)
            (if (or (has-backslash? decoded-path 0) (has-backslash? decoded-fragment 0))
                (invalid-local 'forbidden_character)
                (resolve-decoded-path decoded-path decoded-fragment href document indexed current-slugs))))))))

(defun resolve-decoded-path (path fragment href document indexed current-slugs)
  (if (=:= path #b())
      (resolve-fragment document fragment href indexed current-slugs)
      (if (or (=:= (binary:at path 0) 47) (drive-path? path))
          (invalid-local 'absolute_path)
          (if (not (ends-md? path))
              (if (has-md-suffix? path) (invalid-local 'unsupported_path) 'plain)
              (case (normalise-target document path)
                (`#(error ,reason) (invalid-local reason))
                (`#(ok ,target)
                 (case (maps:find target indexed)
                   ('error `#(error #(unknown_page ,target)))
                   (`#(ok ,data)
                    (resolve-fragment target fragment href indexed
                                      (maps:get 'slug-index data))))))))))

(defun resolve-fragment (target fragment href indexed slugs)
  (case fragment
    (#b() (if (=:= href #b("#")) `#(ok #b("#main"))
              `#(ok ,(maps:get 'route (maps:get target indexed)))))
    (_ (case (maps:find fragment slugs)
         ('error `#(error #(unknown_fragment ,target ,fragment)))
         (`#(ok ,_present)
          (let ((anchor (iolist_to_binary (list #b("#")
                            (uri_string:quote
                              (iolist_to_binary (list #b("h-") fragment)))))))
            (if (or (=:= href #b("#"))
                    (andalso (=:= (binary:at href 0) 35) (module-route? target)))
                `#(ok ,(if (=:= href #b("#")) #b("#main") anchor))
                `#(ok ,(iolist_to_binary (list (maps:get 'route (maps:get target indexed)) anchor))))))))))
(defun module-route? (path)
  (andalso (>= (byte_size path) 8)
           (andalso (=:= (binary:part path 0 2) #b("m-"))
                    (=:= (filename:extension path) #b(".html")))))
(defun ends-md? (path)
  (=:= (filename:extension path) #b(".md")))
(defun has-md-suffix? (path)
  (let ((extension (filename:extension path)))
    (or (=:= extension #b(".md")) (=:= extension #b(".MD")))))
(defun invalid-local (detail) `#(error #(invalid_local_link ,detail)))

(defun decode-component (value)
  (if (not (valid-percent? value 0))
      '#(error malformed_percent)
      (try
        (case (uri_string:percent_decode value)
          (decoded (when (is_binary decoded))
           (case (unicode:characters_to_nfc_binary decoded)
             (normal (when (is_binary normal)) `#(ok ,normal))
             (_ '#(error invalid_utf8))))
          (_ '#(error invalid_utf8)))
        (catch
          (`#(,class ,reason ,stacktrace)
           (case reason
             (`#(error invalid_utf8 ,_bad) '#(error invalid_utf8))
             (_ (erlang:raise class reason stacktrace))))))))
(defun valid-percent? (value pos)
  (if (>= pos (byte_size value)) 'true
      (if (=:= (binary:at value pos) 37)
          (andalso (< (+ pos 2) (byte_size value))
           (andalso (hex? (binary:at value (+ pos 1)))
                    (andalso (hex? (binary:at value (+ pos 2)))
                             (valid-percent? value (+ pos 3)))))
          (valid-percent? value (+ pos 1)))))
(defun hex? (c)
  (or (andalso (>= c 48) (=< c 57))
      (or (andalso (>= c 65) (=< c 70))
          (andalso (>= c 97) (=< c 102)))))
(defun has-backslash? (value pos)
  (if (>= pos (byte_size value)) 'false
      (or (=:= (binary:at value pos) 92) (has-backslash? value (+ pos 1)))))

(defun normalise-target (document path)
  (let* ((source-parts (binary:split document #b("/") (list 'global)))
         (base (if (module-route? document) '()
                   (lists:sublist source-parts (- (length source-parts) 1))))
         (incoming (binary:split path #b("/") (list 'global))))
    (case (normalise-components (lists:append base incoming) '())
      (`#(error ,reason) `#(error ,reason))
      (`#(ok ,parts) `#(ok ,(iolist_to_binary (join-components parts)))))))
(defun normalise-components (parts stack)
  (case parts
    (() `#(ok ,(lists:reverse stack)))
    ((cons #b() _) '#(error root_escape))
    ((cons #b(".") rest) (normalise-components rest stack))
    ((cons #b("..") rest)
     (case stack
       (() '#(error root_escape))
       ((cons _ tail) (normalise-components rest tail))))
    ((cons part rest) (normalise-components rest (cons part stack)))
    (_ '#(error root_escape))))
(defun join-components (parts)
  (case parts
    (() '())
    ((cons part ()) (list part))
    ((cons part rest) (cons part (cons #b("/") (join-components rest))))))
