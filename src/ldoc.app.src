{application, ldoc,
 [{description, "Library for reading BEAM documentation chunks"},
  {vsn, "0.1.0-dev"},
  {registered, []},
  {applications, [kernel, stdlib, lfe, crypto]},
  {env, []},
  {modules, ['ldoc-analysis',
             'ldoc-beam',
             'ldoc-docset',
             'ldoc-eep48',
             'ldoc-etf',
             'ldoc-html',
             'ldoc-html-assets',
             'ldoc-legacy',
             'ldoc-markup',
             'ldoc-store']}]}.
