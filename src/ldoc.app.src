{application, ldoc,
 [{description, "Library for reading BEAM documentation chunks"},
  {vsn, "0.1.0-dev"},
  {registered, []},
  {applications, [kernel, stdlib, lfe, crypto]},
  {env, []},
  {modules, ['ldoc-analysis', 'ldoc-beam', 'ldoc-docset', 'ldoc-eep48', 'ldoc-html', 'ldoc-html-assets', 'ldoc-markup',
             'ldoc-etf', 'ldoc-legacy', 'ldoc-store']}]}.
