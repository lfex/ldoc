{application, ldoc,
 [{description, "Collect native Erlang and LFE documentation into snapshots and static references"},
  {vsn, "0.1.1"},
  {registered, []},
  {applications, [kernel, stdlib, lfe, crypto]},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/lfex/ldoc"}]},
  {files, ["src", "test", "docs/overview.md", "docs/guide.md",
           "docs/maintainers.md", "README.md", "LICENSE",
           "Makefile", "rebar.config", "rebar.lock"]},
  {env, []},
  {modules, ['ldoc-analysis',
             'ldoc-beam',
             'ldoc-docset',
             'ldoc-eep48',
             'ldoc-etf',
             'ldoc-html',
             'ldoc-html-assets',
             'ldoc-legacy',
             'ldoc-markup',
             'ldoc-site',
             ldoc,
             ldoc_cli,
             ldoc_prv,
             'ldoc-store']}]}.
