;;;; Compiled static assets for the standalone HTML reference.

(defmodule ldoc-html-assets
  (export
   (css 0)
   (js 0)))

(defspec (css 0)
  (() (term)))

(defspec (js 0)
  (() (term)))

(defun css ()
  "Return the fixed UTF-8 stylesheet bytes for an offline reference bundle."
  #b("*{box-sizing:border-box}html{scroll-behavior:auto}body{margin:0;color:#202124;background:#fff;font:16px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}a{color:#1769aa;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #1558a6;outline-offset:2px}.skip{position:absolute;left:-9999px;top:0;background:#fff;padding:.5rem;z-index:5}.skip:focus{left:.5rem}.top{height:55px;border-bottom:1px solid #ddd;display:flex;align-items:center;padding:0 2rem;gap:1rem}.brand{font-weight:700;color:#202124}.version{color:#666}.layout{display:grid;grid-template-columns:256px 256px minmax(0,1fr);min-height:calc(100vh - 55px)}.layout.overview{grid-template-columns:256px minmax(0,1fr)}nav{border-right:1px solid #ddd;padding:1.5rem 1rem;overflow:auto}.nav-title{font-size:.75rem;letter-spacing:.08em;color:#666;text-transform:uppercase;margin:1rem 0 .5rem}.filter{width:100%;font:inherit;padding:.5rem;border:1px solid #bbb;border-radius:2px}.nav-list{list-style:none;padding:0;margin:0}.nav-list li{margin:.2rem 0}.nav-list a{display:block;overflow-wrap:anywhere}.api-nav{padding-top:2.3rem}.content{min-width:0;padding:2rem 2rem 4rem 4rem;overflow:auto}.module-content{width:80%;max-width:none}.module-title{font-size:24px;line-height:1.15;margin:.2rem 0 1.5rem;padding-bottom:.8rem;border-bottom:1px solid #ddd;overflow-wrap:anywhere}.definition{border-bottom:1px solid #ddd;padding:1rem 0 1.4rem;scroll-margin-top:4.5rem}.definition h2{font-size:16px;line-height:1.15;margin:0 0 .8rem;font-weight:700}.definition h2 a{color:inherit}.kind{font-size:.75rem;color:#686868;font-weight:400;margin-left:.45rem}.signatures{font:16px/1.15 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;margin:0 0 .8rem}.patterns{font:14px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere;background:#f7f7f7;padding:.6rem}.doc{margin:.7rem 0}.doc p{margin:0 0 1rem}.doc h1,.doc h2,.doc h3,.doc h4{line-height:1.2}.doc pre{overflow:auto;background:#f6f6f6;padding:.75rem}.doc code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;background:#f3f4f4;padding:.05em .2em}.doc pre code{background:transparent;padding:0}.doc blockquote{margin:.8rem 0;padding-left:1rem;border-left:3px solid #b7c6d4;color:#444}.doc table{border-collapse:collapse;width:100%;margin:.8rem 0}.doc th,.doc td{border:1px solid #ccc;padding:.45rem;text-align:left;vertical-align:top;overflow-wrap:anywhere}.doc th{background:#f7f7f7}.state{font-size:.9rem;color:#656565;font-style:italic}.overview-content{max-width:48rem;margin:1.5rem auto;padding:1rem}.mobile-bar,.menu-button{display:none}.mobile-strip,nav.mobile-nav{display:none}.status{font-size:.85rem;color:#555;min-height:1.4em}.source{font-size:.8rem;color:#666;margin-top:.8rem}.hidden[hidden]{display:none!important}@media(max-width:1050px){.layout{grid-template-columns:220px minmax(0,1fr)}.api-nav{display:none}.content{padding-inline:1.5rem}}@media(max-width:700px){.top{height:38px;padding:0 1rem}.layout,.layout.overview{display:block;min-height:calc(100vh - 83px)}.desktop-nav{display:none}nav.mobile-nav{display:block;border:0;padding:1rem;overflow:visible}.js-enabled:not(.menu-open) .mobile-nav{display:none}[hidden]{display:none!important}.mobile-strip{display:block}.mobile-bar{display:flex;height:35px;background:#eee;align-items:center;padding:0 1rem}.mobile-strip{height:10px;background:#3482d2}.menu-button{display:inline-flex;margin-left:auto;border:0;background:transparent;font:inherit;align-items:center;gap:.6rem;padding:0;cursor:pointer}.content{padding:1rem;overflow:visible}.overview-content{margin:0;padding:1rem}.module-content{width:auto;max-width:none}.menu-open .content{display:none}.menu-open .mobile-nav{display:block}.menu-open .content{visibility:hidden}.doc table{display:block;overflow-x:auto;max-width:100%}.doc pre{max-width:100%}.definition{scroll-margin-top:4.5rem}}
"))

(defun js ()
  "Return the fixed progressive-enhancement script bytes."
  #b("document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('js-enabled');var button=document.querySelector('[data-menu-button]');var nav=document.querySelector('[data-mobile-nav]');var main=document.querySelector('main');if(button&&nav&&main){button.hidden=false;var closeMenu=function(){document.body.classList.remove('menu-open');nav.hidden=true;button.setAttribute('aria-expanded','false');button.textContent='☰ Tap for navigation';main.hidden=false;button.focus();};button.addEventListener('click',function(){var open=button.getAttribute('aria-expanded')!=='true';document.body.classList.toggle('menu-open',open);button.setAttribute('aria-expanded',String(open));button.textContent=open?'‹ Back to Content':'☰ Tap for navigation';nav.hidden=!open;main.hidden=open;});document.addEventListener('keydown',function(event){if(event.key==='Escape'&&document.body.classList.contains('menu-open')){closeMenu();}});nav.addEventListener('click',function(event){if(event.target.closest('a')){document.body.classList.remove('menu-open');button.setAttribute('aria-expanded','false');button.textContent='☰ Tap for navigation';main.hidden=false;nav.hidden=true;}});}document.querySelectorAll('[data-filter]').forEach(function(filter){var nav=filter.closest('nav');var items=Array.from(nav.querySelectorAll('[data-filter-item]'));var status=nav.querySelector('[data-filter-status]');var apply=function(){var needle=filter.value.toLocaleLowerCase();var shown=0;items.forEach(function(item){var match=item.textContent.toLocaleLowerCase().includes(needle);item.hidden=!match;if(match){shown+=1;}});if(status){status.textContent=needle?shown+' matching navigation items':'All navigation items';}};filter.addEventListener('input',apply);filter.hidden=false;});}
);
"))
