;;;; Compiled, reviewable assets for the standalone HTML reference.

(defmodule ldoc-html-assets
  (export
   (css 0)
   (js 0)))

(defspec (css 0)
  (() (binary)))
(defspec (js 0)
  (() (binary)))

(defun css ()
  "Return the fixed UTF-8 stylesheet bytes without filesystem access."
  (iolist_to_binary
    (list
      #b("*{box-sizing:border-box}\n")
      #b("html{scroll-behavior:auto}\n")
      #b("body{margin:0;height:100vh;overflow:hidden;color:#202124;background:#fff;font:16px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n")
      #b("a{color:#1769aa;text-decoration:none}a:hover{text-decoration:underline}\n")
      #b("a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #1558a6;outline-offset:2px}\n")
      #b(".skip{position:absolute;left:-9999px;top:0;background:#fff;padding:.5rem;z-index:10}.skip:focus{left:.5rem}\n")
      #b(".top{height:55px;position:relative;z-index:3;display:flex;align-items:center;gap:1rem;padding:0 2rem;border-bottom:1px solid #ddd;background:#fff;font-size:14px}\n")
      #b(".library{font-weight:700}.version{color:#555}.brand-mark{margin-left:auto;border:1px solid #999;border-radius:2px;padding:0 .35rem;color:#444;font-size:.75rem;line-height:1.4}\n")
      #b(".mobile-toolbar{display:none}.mobile-strip{height:10px;background:#3482d2}\n")
      #b(".page-layout{display:flex;height:calc(100vh - 55px);min-height:0;overflow:hidden}\n")
      #b(".nav-panel{display:flex;flex:0 0 512px;min-width:0;min-height:0;border-right:1px solid #ddd;overflow:hidden}\n")
      #b(".nav-columns{display:flex;min-width:0;flex:1}.primary-nav,.definition-nav{width:256px;flex:0 0 256px;min-width:0;padding:32px;overflow:auto}\n")
      #b(".definition-nav{border-left:1px solid #eee}.nav-title{margin:1rem 0 .5rem;color:#555;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase}.language-group+.language-group{margin-top:1.25rem}\n")
      #b(".nav-list{margin:0;padding:0;list-style:none}.nav-list li{margin:.2rem 0}.nav-list a{display:block;overflow-wrap:anywhere}.nav-list a[aria-current=page]{font-weight:700;color:#202124}\n")
      #b(".filter-control{padding:0 0 .75rem}.filter-control label{display:block;margin-bottom:.25rem}.filter{width:100%;font:inherit;padding:.35rem;border:1px solid #aaa;border-radius:2px}.filter-clear{margin-top:.4rem;border:0;background:transparent;color:#1558a6;text-decoration:underline;font:inherit;cursor:pointer}.status{min-height:1.4em;margin:.25rem 0 0;color:#555;font-size:.8rem}\n")
      #b(".content{flex:1;min-width:0;min-height:0;overflow:auto;padding:32px 32px 64px 64px}.overview-content{max-width:48rem;margin:0 auto;padding:0 0 2rem}.overview-content h1{margin:1.2rem 0 1.5rem;font-size:24px;line-height:1.15}.overview-modules{padding-left:1.25rem}\n")
      #b(".module-content{width:80%;max-width:none}.module-title{margin:20px 0 1.5rem;padding-bottom:.8rem;border-bottom:1px solid #ddd;font-size:24px;line-height:1.15;overflow-wrap:anywhere}.definition{padding:1rem 0 1.4rem;border-bottom:1px solid #ddd;scroll-margin-top:1rem}.definition h2{margin:0 0 .8rem;font-size:16px;line-height:1.15;font-weight:700;overflow-wrap:anywhere}.definition h2 a{color:inherit}.kind{margin-left:.45rem;color:#555;font-size:.75rem;font-weight:400}\n")
      #b(".signatures{margin:0 0 .8rem;font:16px/1.15 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.patterns{padding:.6rem;background:#f7f7f7;font:14px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}\n")
      #b(".doc{margin:.7rem 0}.doc p{margin:0 0 1rem}.doc h1,.doc h2,.doc h3,.doc h4,.doc h5,.doc h6{line-height:1.2}.doc pre{max-width:100%;overflow:auto;padding:.75rem;background:#f6f6f6}.doc code{padding:.05em .2em;background:#f3f4f4;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.doc pre code{padding:0;background:transparent}\n")
      #b(".doc blockquote{margin:.8rem 0;padding-left:1rem;border-left:3px solid #9eafbf;color:#444}.table-scroll{max-width:100%;overflow-x:auto}.doc table{width:max-content;min-width:100%;border-collapse:collapse;margin:.8rem 0}.doc th,.doc td{border:1px solid #bbb;padding:.45rem;text-align:left;vertical-align:top;overflow-wrap:anywhere}.doc th{background:#f7f7f7}.state{color:#555;font-size:.9rem;font-style:italic}.source{margin-top:.8rem;color:#555;font-size:.8rem}\n")
      #b("@media(max-width:1100px) and (min-width:701px){.nav-panel{flex-basis:440px}.primary-nav,.definition-nav{width:220px;flex-basis:220px;padding:24px}.content{padding-left:40px;padding-right:24px}.module-content{width:90%}}\n")
      #b("@media(max-width:700px){body{height:auto;min-height:100vh;overflow:auto}.top{height:38px;padding:0 1rem;gap:.6rem}.library{font-size:.9rem}.version{font-size:.85rem}.brand-mark{font-size:.7rem}.mobile-toolbar{display:none}.page-layout{height:auto;min-height:0;display:block;overflow:visible}.nav-panel{display:flex;width:auto;min-height:0;border:0;border-bottom:1px solid #ddd;overflow:visible}.nav-columns{display:block}.primary-nav,.definition-nav{width:auto;padding:16px;overflow:visible}.definition-nav{border-left:0;border-top:1px solid #eee}.content{min-height:0;overflow:visible;padding:32px 16px}.module-content{width:auto;max-width:none}.module-title{margin:20px 0 1.5rem}.overview-content{padding:0}.doc table{min-width:100%}.doc th,.doc td{overflow-wrap:anywhere}.doc pre{max-width:100%}.definition{scroll-margin-top:16px}.js-enabled{height:100vh;min-height:0;overflow:hidden}.js-enabled .mobile-toolbar{position:relative;z-index:3;display:block;background:#eee}.js-enabled .menu-button{display:flex;width:100%;height:35px;align-items:center;justify-content:flex-start;padding:0 16px;border:0;background:transparent;color:#202124;font:inherit;text-align:left;cursor:pointer}.js-enabled .mobile-strip{height:10px}.js-enabled .page-layout{height:calc(100vh - 83px);min-height:0;overflow:hidden}.js-enabled .content{height:100%;overflow:auto;padding:32px 16px}.js-enabled .nav-panel{height:100%;overflow:auto}.js-enabled:not(.menu-open) .nav-panel{display:none}.js-enabled.menu-open .nav-panel{display:block}.js-enabled .doc table{width:max-content;min-width:100%}.js-enabled.menu-open .nav-columns{display:block}.js-enabled.menu-open .primary-nav,.js-enabled.menu-open .definition-nav{width:auto;padding:16px}.js-enabled.menu-open .definition-nav{border-left:0;border-top:1px solid #eee}.js-enabled.menu-open .content[hidden]{display:none!important}}")
)))

(defun js ()
  "Return the fixed progressive-enhancement script bytes."
  #b("document.addEventListener('DOMContentLoaded', () => {\n  const body = document.body;\n  const button = document.querySelector('[data-menu-button]');\n  const navigation = document.querySelector('[data-navigation]');\n  const main = document.querySelector('main');\n  const filter = document.querySelector('[data-filter]');\n  const label = document.querySelector('label[for=\"api-filter\"]');\n  const clear = document.querySelector('[data-filter-clear]');\n  const status = document.querySelector('[data-filter-status]');\n  if (!button || !navigation || !main || !filter || !label || !clear) return;\n\n  body.classList.add('js-enabled');\n  button.hidden = false;\n  filter.hidden = false;\n  label.hidden = false;\n  clear.hidden = false;\n  const items = Array.from(navigation.querySelectorAll('[data-filter-item]'));\n  const mobile = window.matchMedia('(max-width: 700px)');\n  let menuOpen = false;\n  const syncMenu = () => {\n    const isMobileOpen = mobile.matches && menuOpen;\n    navigation.hidden = mobile.matches && !menuOpen;\n    main.hidden = isMobileOpen;\n    button.setAttribute('aria-expanded', String(isMobileOpen));\n    button.textContent = isMobileOpen ? '‹ Back to Content' : '☰ Open navigation';\n    body.classList.toggle('menu-open', isMobileOpen);\n  };\n  const closeMenu = (restoreFocus) => {\n    menuOpen = false;\n    syncMenu();\n    if (restoreFocus) button.focus();\n  };\n  button.addEventListener('click', () => {\n    menuOpen = !menuOpen;\n    syncMenu();\n  });\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape' && menuOpen) closeMenu(true);\n  });\n  navigation.addEventListener('click', (event) => {\n    if (mobile.matches && event.target.closest('a')) closeMenu(false);\n  });\n  mobile.addEventListener('change', () => {\n    if (!mobile.matches) menuOpen = false;\n    syncMenu();\n  });\n\n  const applyFilter = () => {\n    const needle = filter.value.toLocaleLowerCase();\n    let shown = 0;\n    for (const item of items) {\n      const matches = item.textContent.toLocaleLowerCase().includes(needle);\n      item.hidden = !matches;\n      if (matches) shown += 1;\n    }\n    status.textContent = needle ? `${shown} matching navigation items` : 'All navigation items';\n  };\n  filter.addEventListener('input', applyFilter);\n  clear.addEventListener('click', () => {\n    filter.value = '';\n    applyFilter();\n    filter.focus();\n  });\n  syncMenu();\n  applyFilter();\n});\n"))
