;;;; Compiled, reviewable assets for the standalone HTML reference.

(defmodule ldoc-html-assets
  (export
   (css 0)
   (js 0)))

(defspec (css 0)
  (() (binary)))
(defspec (js 0)
  (() (binary)))

(defun css ()
  "Return the fixed UTF-8 stylesheet bytes without filesystem access."
  (iolist_to_binary
    (list
      #b("*{box-sizing:border-box}\n")
      #b("html{scroll-behavior:auto}\n")
      #b("body{margin:0;height:100vh;display:flex;flex-direction:column;color:#202124;background:#fff;font:16px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n")
      #b("a{color:#1769aa;text-decoration:none}a:hover{text-decoration:underline}\n")
      #b("a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #1558a6;outline-offset:2px}\n")
      #b("[hidden]{display:none!important}\n")
      #b(".skip{position:absolute;left:-9999px;top:0;background:#fff;padding:.5rem;z-index:10}.skip:focus{left:.5rem}\n")
      #b(".top{min-height:55px;flex:0 0 auto;position:relative;z-index:3;display:flex;align-items:center;gap:1rem;padding:0 2rem;border-bottom:1px solid #ddd;background:#fff;font-size:14px}\n")
      #b(".library{font-weight:700;min-width:0;overflow-wrap:anywhere}.version{color:#555;min-width:0;overflow-wrap:anywhere}.brand-mark{border:1px solid #999;border-radius:2px;padding:0 .35rem;color:#444;font-size:.75rem;line-height:1.4;flex:0 0 auto}\n")
      #b(".mobile-toolbar{display:none}.mobile-strip{height:10px;background:#3482d2}\n")
      #b(".page-layout{display:flex;flex:1 1 auto;min-height:0}\n")
      #b(".nav-panel{display:flex;flex:0 0 512px;min-width:0;min-height:0;border-right:1px solid #ddd;overflow:hidden}\n")
      #b(".overview-layout .nav-panel{flex-basis:256px}\n")
      #b(".nav-columns{display:flex;min-width:0;flex:1}.primary-nav,.definition-nav{width:256px;flex:0 0 256px;min-width:0;padding:32px;overflow:auto}\n")
      #b(".definition-nav{border-left:1px solid #eee}.nav-title{margin:1rem 0 .5rem;color:#555;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase}.language-group+.language-group{margin-top:1.25rem}\n")
      #b(".nav-list{margin:0;padding:0;list-style:none}.nav-list li{margin:.2rem 0}.nav-list a{display:block;overflow-wrap:anywhere}.nav-list a[aria-current=page]{font-weight:700;color:#202124}\n")
      #b(".filter-control{padding:0 0 .75rem}.filter-control label{display:block;margin-bottom:.25rem}.filter{width:100%;font:inherit;padding:.35rem;border:1px solid #aaa;border-radius:2px}.filter-clear{margin-top:.4rem;border:0;background:transparent;color:#1558a6;text-decoration:underline;font:inherit;cursor:pointer}.status{min-height:1.4em;margin:.25rem 0 0;color:#555;font-size:.8rem}\n")
      #b(".content{flex:1;min-width:0;min-height:0;overflow:auto;padding:32px 32px 64px 64px}.overview-content{max-width:48rem;margin:0 auto;padding:0 0 2rem;overflow-wrap:anywhere}.overview-content h1{margin:21.44px 0;font-size:32px;line-height:48px;font-weight:700}.overview-modules{padding-left:1.25rem}\n")
      #b(".module-content{width:80%;max-width:none}.module-title{margin:20px 0 1.5rem;padding-bottom:.8rem;border-bottom:1px solid #ddd;font-size:24px;line-height:1.15;overflow-wrap:anywhere}.definition{padding:1rem 0 1.4rem;border-bottom:1px solid #ddd;scroll-margin-top:1rem}.definition h2{margin:0 0 .8rem;font-size:16px;line-height:1.15;font-weight:700;overflow-wrap:anywhere}.definition h2 a{color:inherit}.kind{margin-left:.45rem;color:#555;font-size:.75rem;font-weight:400}\n")
      #b(".signature{margin:0 0 16px;font:16px/1.15 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.patterns{padding:.6rem;background:#f7f7f7;font:14px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}\n")
      #b(".doc{margin:.7rem 0}.doc p{margin:0 0 1rem}.doc h1,.doc h2,.doc h3,.doc h4,.doc h5,.doc h6{line-height:1.2}.doc pre{max-width:100%;overflow:auto;padding:.75rem;background:#f6f6f6}.doc code{padding:.05em .2em;background:#f3f4f4;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.doc pre code{padding:0;background:transparent}\n")
      #b(".doc blockquote{margin:.8rem 0;padding-left:1rem;border-left:3px solid #9eafbf;color:#444}.table-scroll{max-width:100%;overflow-x:auto}.doc table{width:100%;min-width:100%;border-collapse:collapse;margin:.8rem 0}.doc th,.doc td{border:1px solid #bbb;padding:.45rem;text-align:left;vertical-align:top;overflow-wrap:anywhere}.doc th{background:#f7f7f7}.state{color:#555;font-size:.9rem;font-style:italic}.source{margin-top:.8rem;color:#555;font-size:.8rem}\n")
      #b("@media(max-width:1100px) and (min-width:901px){\n")
      #b(".nav-panel{flex-basis:440px}\n")
      #b(".overview-layout .nav-panel{flex-basis:220px}\n")
      #b(".primary-nav,.definition-nav{width:220px;flex-basis:220px;padding:24px}\n")
      #b(".content{padding-left:40px;padding-right:24px}\n")
      #b(".module-content{width:90%}\n")
      #b("}\n")
      #b("@media(max-width:900px) and (min-width:701px){\n")
      #b(".nav-panel{flex-basis:256px;overflow:auto}\n")
      #b(".overview-layout .nav-panel{flex-basis:256px}\n")
      #b(".nav-columns{display:block}\n")
      #b(".primary-nav,.definition-nav{width:auto;flex-basis:auto;padding:24px;overflow:auto}\n")
      #b(".definition-nav{border-left:0;border-top:1px solid #eee}\n")
      #b(".content{padding-left:40px;padding-right:24px}\n")
      #b(".module-content{width:auto;max-width:48rem}\n")
      #b("}\n")
      #b("@media(max-width:700px){\n")
      #b("body{height:auto;min-height:100vh;display:block;overflow:auto}\n")
      #b(".top{min-height:38px;height:auto;flex-wrap:wrap;padding:0 1rem;gap:.6rem}\n")
      #b(".library{font-size:.9rem}.version{font-size:.85rem}.brand-mark{font-size:.7rem}\n")
      #b(".mobile-toolbar{display:none}\n")
      #b(".page-layout{height:auto;min-height:0;display:block;overflow:visible}\n")
      #b(".nav-panel{display:flex;width:auto;min-height:0;border:0;border-bottom:1px solid #ddd;overflow:visible}\n")
      #b(".nav-columns{display:block}\n")
      #b(".primary-nav,.definition-nav{width:auto;padding:16px;overflow:visible}\n")
      #b(".definition-nav{border-left:0;border-top:1px solid #eee}\n")
      #b(".content{min-height:0;overflow:visible;padding:32px 16px}\n")
      #b(".module-content{width:auto;max-width:none}\n")
      #b(".module-title{margin:20px 0 1.5rem}.overview-content{padding:0}\n")
      #b(".doc table{min-width:100%}.doc th,.doc td{overflow-wrap:anywhere}.doc pre{max-width:100%}\n")
      #b(".definition{scroll-margin-top:16px}\n")
      #b("}\n")
      #b("@media(max-width:700px){\n")
      #b("body.js-enabled{height:100vh;min-height:0;display:flex;flex-direction:column;overflow:hidden}\n")
      #b(".js-enabled .top{flex:0 0 auto}\n")
      #b(".js-enabled .mobile-toolbar{display:block;flex:0 0 auto;background:#eee}\n")
      #b(".js-enabled .menu-button{display:flex;width:100%;min-height:35px;height:auto;align-items:center;justify-content:flex-start;flex-wrap:wrap;padding:0 16px;border:0;background:transparent;color:#202124;font:inherit;text-align:left;cursor:pointer}\n")
      #b(".js-enabled .mobile-strip{height:10px}\n")
      #b(".js-enabled .page-layout{height:auto;min-height:0;display:flex;flex:1 1 auto;overflow:hidden}\n")
      #b(".js-enabled .content{height:auto;flex:1 1 auto;min-height:0;overflow:auto;padding:32px 16px}\n")
      #b(".js-enabled .nav-panel{height:auto;flex:1 1 auto;min-height:0;overflow:auto}\n")
      #b(".js-enabled:not(.menu-open) .nav-panel{display:none}\n")
      #b(".js-enabled.menu-open .nav-panel{display:block}\n")
      #b(".js-enabled .doc table{width:100%;min-width:100%}\n")
      #b(".js-enabled.menu-open .nav-columns{display:block}\n")
      #b(".js-enabled.menu-open .primary-nav,.js-enabled.menu-open .definition-nav{width:auto;padding:16px}\n")
      #b(".js-enabled.menu-open .definition-nav{border-left:0;border-top:1px solid #eee}\n")
      #b("}\n"))))

(defun js ()
  "Return the fixed progressive-enhancement script bytes."
  (iolist_to_binary
    (list
      #b("document.addEventListener('DOMContentLoaded', () => {\n")
      #b("  const body = document.body;\n")
      #b("  const button = document.querySelector('[data-menu-button]');\n")
      #b("  const navigation = document.querySelector('[data-navigation]');\n")
      #b("  const main = document.querySelector('main');\n")
      #b("  const skip = document.querySelector('.skip');\n")
      #b("  const filter = document.querySelector('[data-filter]');\n")
      #b("  const label = document.querySelector('label[for=\"api-filter\"]');\n")
      #b("  const clear = document.querySelector('[data-filter-clear]');\n")
      #b("  const status = document.querySelector('[data-filter-status]');\n")
      #b("  if (!button || !navigation || !main || !skip || !filter || !label || !clear || !status) return;\n\n")
      #b("  body.classList.add('js-enabled');\n")
      #b("  button.hidden = false;\n")
      #b("  filter.hidden = false;\n")
      #b("  label.hidden = false;\n")
      #b("  clear.hidden = false;\n")
      #b("  const items = Array.from(navigation.querySelectorAll('[data-filter-item]'));\n")
      #b("  const mobile = window.matchMedia('(max-width: 700px)');\n")
      #b("  let menuOpen = false;\n")
      #b("  const syncMenu = () => {\n")
      #b("    const isMobileOpen = mobile.matches && menuOpen;\n")
      #b("    navigation.hidden = mobile.matches && !menuOpen;\n")
      #b("    main.hidden = isMobileOpen;\n")
      #b("    button.setAttribute('aria-expanded', String(isMobileOpen));\n")
      #b("    button.textContent = isMobileOpen ? '‹ Back to Content' : '☰ Open navigation';\n")
      #b("    body.classList.toggle('menu-open', isMobileOpen);\n")
      #b("  };\n")
      #b("  const closeMenu = (restoreFocus) => {\n")
      #b("    menuOpen = false;\n")
      #b("    syncMenu();\n")
      #b("    if (restoreFocus) button.focus();\n")
      #b("  };\n")
      #b("  skip.addEventListener('click', () => {\n")
      #b("    if (menuOpen) closeMenu(false);\n")
      #b("  });\n")
      #b("  button.addEventListener('click', () => {\n")
      #b("    menuOpen = !menuOpen;\n")
      #b("    syncMenu();\n")
      #b("  });\n")
      #b("  document.addEventListener('keydown', (event) => {\n")
      #b("    if (event.key === 'Escape' && menuOpen) closeMenu(true);\n")
      #b("  });\n")
      #b("  navigation.addEventListener('click', (event) => {\n")
      #b("    if (mobile.matches && event.target.closest('a')) closeMenu(false);\n")
      #b("  });\n")
      #b("  mobile.addEventListener('change', () => {\n")
      #b("    if (!mobile.matches) menuOpen = false;\n")
      #b("    syncMenu();\n")
      #b("  });\n\n")
      #b("  const applyFilter = () => {\n")
      #b("    const needle = filter.value.toLocaleLowerCase();\n")
      #b("    let shown = 0;\n")
      #b("    for (const item of items) {\n")
      #b("      const matches = item.textContent.toLocaleLowerCase().includes(needle);\n")
      #b("      item.hidden = !matches;\n")
      #b("      if (matches) shown += 1;\n")
      #b("    }\n")
      #b("    status.textContent = needle ? `${shown} matching navigation items` : 'All navigation items';\n")
      #b("  };\n")
      #b("  filter.addEventListener('input', applyFilter);\n")
      #b("  clear.addEventListener('click', () => {\n")
      #b("    filter.value = '';\n")
      #b("    applyFilter();\n")
      #b("    filter.focus();\n")
      #b("  });\n")
      #b("  syncMenu();\n")
      #b("  applyFilter();\n")
      #b("});\n"))))
