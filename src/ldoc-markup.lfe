;;;; Safe, bounded documentation rendering for static HTML.

(defmodule ldoc-markup
  (export
   (escape 1)
   (render 2)))

(defspec (escape 1)
  ([(term)] (term)))

(defspec (render 2)
  ([(term) (term)] (term)))

(defun escape (text)
  "Escape a validated UTF-8 binary for text or a quoted HTML attribute."
  (let* ((amp (binary:replace text #b("&") #b("&amp;") (list 'global)))
         (less (binary:replace amp #b("<") #b("&lt;") (list 'global)))
         (greater (binary:replace less #b(">") #b("&gt;") (list 'global)))
         (double (binary:replace greater #b("\"") #b("&quot;") (list 'global))))
    (binary:replace double #b("'") #b("&#39;") (list 'global))))

(defun render (format value)
  "Render a supported Markdown or structured EDoc body as safe HTML."
  (case (valid-text value)
    ('false '#(error invalid_documentation))
    ('true
     (let ((output (case format
                     (#b("text/markdown") (if (is_binary value) (markdown value) (escape (readable value))))
                     (#b("application/erlang+html") (edoc value))
                     (_ (escape (readable value))))))
       (case (unicode:characters_to_binary output 'utf8 'utf8)
         (converted (when (is_binary converted)) `#(ok ,converted))
         (_ '#(error invalid_documentation)))))))

(defun valid-text (value)
  (case value
    (binary (when (is_binary binary))
     (case (unicode:characters_to_binary binary 'utf8 'utf8)
       (converted (when (is_binary converted)) 'true)
       (_ 'false)))
    (() 'true)
    ((cons _ _) (valid-list-value value))
    ((tuple tag attrs children)
     (andalso (is_atom tag)
              (andalso (valid-attrs attrs)
                       (valid-text children))))
    (tuple-value (when (is_tuple tuple-value)) 'false)
    (_ 'true)))
(defun valid-list-value (value)
  (case value
    (() 'true)
    ((cons head tail) (andalso (valid-text head) (valid-list-value tail)))
    (_ 'false)))
(defun valid-attrs (attrs)
  (case attrs
    (() 'true)
    ((cons item rest)
     (case item
       ((tuple key value)
        (andalso (is_atom key) (andalso (is_binary value) (andalso (valid-text value) (valid-attrs rest)))))
       (_ 'false)))
    (_ 'false)))

(defun readable (value)
  (case value
    (binary (when (is_binary binary)) binary)
    (_ (unicode:characters_to_binary (lfe_io:prettyprint1 value -1) 'utf8 'utf8))))

(defun markdown (text)
  (iolist_to_binary (markdown-lines (binary:split text #b("\n") (list 'global)) 'normal)))

(defun markdown-lines (lines mode)
  (case lines
    (() (if (=:= mode 'fence) #b("</code></pre>") '()))
    ((cons line rest)
     (case mode
       ('fence
        (if (prefix? line #b("```"))
            (cons #b("</code></pre>") (markdown-lines rest 'normal))
            (cons (list (escape line) #b("\n"))
                  (markdown-lines rest 'fence))))
       (_ (markdown-line line rest))))))

(defun markdown-line (line rest)
  (cond
    ((table-header? line rest)
     (case rest
       ((cons _table-delimiter tail)
        (let* ((split (lists:splitwith #'pipe-row?/1 tail))
               (rows (element 1 split))
               (remaining (element 2 split)))
          (cons (render-table (table-cells line) rows)
                (markdown-lines remaining 'normal))))))
    ((prefix? line #b("```"))
     (cons #b("<pre><code>") (markdown-lines rest 'fence)))
    ((=:= line #b())
     (markdown-lines rest 'normal))
    ((heading? line)
     (let* ((level (heading-level line))
            (body (binary:part line level (- (byte_size line) level)))
            (trimmed (trim-left body)))
       (cons (list #b("<h") (integer_to_binary level) #b(">")
                                    (inline trimmed) #b("</h") (integer_to_binary level) ">")
             (markdown-lines rest 'normal))))
    ((prefix? line #b("> "))
     (cons (list #b("<blockquote><p>") (inline (binary:part line 2 (- (byte_size line) 2)))
                                  #b("</p></blockquote>"))
           (markdown-lines rest 'normal)))
    ((prefix? line #b("- "))
     (cons (list #b("<ul><li>") (inline (binary:part line 2 (- (byte_size line) 2))) #b("</li></ul>"))
           (markdown-lines rest 'normal)))
    ((ordered-item line)
     (cons (list #b("<ol><li>") (inline (ordered-text line)) #b("</li></ol>"))
           (markdown-lines rest 'normal)))
    ('true
     (let ((paragraph (take-paragraph (cons line rest) '())))
       (cons (list #b("<p>") (inline (join-lines paragraph)) #b("</p>"))
             (markdown-lines (drop-lines paragraph (cons line rest)) 'normal))))))

(defun table-header? (line rest)
  (case rest
    ((cons delimiter _)
     (andalso (pipe-row? line)
              (andalso (pipe-row? delimiter) (table-delimiter? delimiter))))
    (_ 'false)))
(defun pipe-row? (line)
  (andalso (> (byte_size line) 1)
           (andalso (=:= (binary:at line 0) 124)
                    (=:= (binary:at line (- (byte_size line) 1)) 124))))
(defun table-delimiter? (line)
  (table-delimiter-at? line 0 'false))
(defun table-delimiter-at? (line index dash-seen)
  (if (>= index (byte_size line)) dash-seen
      (let ((byte (binary:at line index)))
        (if (or (=:= byte 124) (=:= byte 45) (=:= byte 58) (=:= byte 32))
            (table-delimiter-at? line (+ index 1) (or dash-seen (=:= byte 45)))
            'false))))
(defun table-cells (line)
  (let* ((parts (binary:split line #b("|") (list 'global)))
         (without-leading (if (=:= (hd parts) #b()) (lists:nthtail 1 parts) parts))
         (middle (if (=:= (lists:last without-leading) #b())
                     (lists:sublist without-leading (- (length without-leading) 1))
                     without-leading)))
    (lists:map #'trim-cell/1 middle)))
(defun trim-cell (cell)
  (trim-right (trim-left cell)))
(defun trim-right (cell)
  (if (andalso (> (byte_size cell) 0)
               (=:= (binary:at cell (- (byte_size cell) 1)) 32))
      (trim-right (binary:part cell 0 (- (byte_size cell) 1)))
      cell))
(defun render-table (headers rows)
  (list #b("<table><thead><tr>")
        (render-table-cells headers 'th)
        #b("</tr></thead><tbody>")
        (lists:map #'render-table-row/1 rows)
        #b("</tbody></table>")))
(defun render-table-row (line)
  (list #b("<tr>") (render-table-cells (table-cells line) 'td) #b("</tr>")))
(defun render-table-cells (cells tag)
  (case cells
    (() '())
    ((cons cell rest)
     (list (if (=:= tag 'th) #b("<th>") #b("<td>"))
           (inline cell)
           (if (=:= tag 'th) #b("</th>") #b("</td>"))
           (render-table-cells rest tag)))))

(defun heading? (line)
  (is_integer (heading-level line)))

(defun heading-level (line)
  (heading-level line 0))
(defun heading-level (line count)
  (case line
    (binary (when (is_binary binary)) (if (andalso (< count 6) (> (byte_size line) count)
                           (=:= (binary:at line count) 35))
                  (heading-level line (+ count 1))
                  (if (andalso (> count 0) (< count 7)
                               (> (byte_size line) count)
                               (=:= (binary:at line count) 32)) count 'false)))
    (_ 'false)))

(defun prefix? (text prefix)
  (andalso (>= (byte_size text) (byte_size prefix))
           (=:= (binary:part text 0 (byte_size prefix)) prefix)))

(defun ordered-item (line)
  (case (binary:match line #b(". "))
    (`#(,position ,2) (andalso (> position 0) (all-digits? (binary:part line 0 position))))
    (_ 'false)))
(defun ordered-text (line)
  (case (binary:match line #b(". "))
    (`#(,position ,2) (binary:part line (+ position 2) (- (byte_size line) (+ position 2))))
    (_ line)))
(defun all-digits? (value)
  (case value
    (#b() 'false)
    (binary (when (is_binary binary)) (all-digits-at? binary 0))
    (_ 'false)))
(defun all-digits-at? (value index)
  (if (>= index (byte_size value)) 'true
      (let ((c (binary:at value index)))
        (andalso (>= c 48) (=< c 57) (all-digits-at? value (+ index 1))))))

(defun trim-left (value)
  (if (andalso (> (byte_size value) 0) (=:= (binary:at value 0) 32))
      (binary:part value 1 (- (byte_size value) 1)) value))
(defun take-paragraph (lines acc)
  (case lines
    (() (lists:reverse acc))
    ((cons line rest)
     (if (or (=:= line #b()) (prefix? line #b("```")) (heading? line)
             (prefix? line #b("> ")) (prefix? line #b("- ")) (ordered-item line))
         (lists:reverse acc)
         (take-paragraph rest (cons line acc))))))
(defun drop-lines (paragraph lines)
  (lists:nthtail (length paragraph) lines))
(defun join-lines (lines)
  (case lines
    (() #b())
    ((cons line ()) line)
    ((cons line rest) (list line #b(" ") (join-lines rest)))))

(defun inline (text)
  (inline-at text 0))
(defun inline-at (text position)
  (if (>= position (byte_size text)) #b()
      (case (match-inline text position)
        (`#(link ,label-start ,label-end ,url-start ,url-end ,after)
         (list #b("<a href=\"")
               (escape (binary:part text url-start (- url-end url-start)))
               #b("\">") (inline (binary:part text label-start (- label-end label-start)))
               #b("</a>") (inline-at text after)))
        (`#(code ,start ,end)
         (list #b("<code>") (escape (binary:part text start (- end start))) #b("</code>")
               (inline-at text (+ end 1))))
        (`#(strong ,start ,end)
         (list #b("<strong>") (inline (binary:part text start (- end start))) #b("</strong>")
               (inline-at text (+ end 2))))
        (`#(em ,start ,end)
         (list #b("<em>") (inline (binary:part text start (- end start))) #b("</em>")
               (inline-at text (+ end 1))))
        ('none
         (let ((width (utf8-width text position)))
           (list (escape (binary:part text position width))
                 (inline-at text (+ position width))))))))

(defun utf8-width (text position)
  (let ((byte (binary:at text position)))
    (cond ((< byte 128) 1)
          ((< byte 224) 2)
          ((< byte 240) 3)
          ('true 4))))
(defun match-inline (text position)
  (let ((link (link-at text position)))
    (if (is_tuple link) link (match-inline-non-link text position))))
(defun match-inline-non-link (text position)
  (let ((rest (binary:part text position (- (byte_size text) position))))
    (cond
      ((prefix? rest #b("`")) (delimited text position 1 96 'code))
      ((prefix? rest #b("**")) (delimited text position 2 42 'strong))
      ((prefix? rest #b("*")) (delimited text position 1 42 'em))
      ('true 'none))))
(defun link-at (text position)
  (let ((tail (binary:part text position (- (byte_size text) position))))
    (if (prefix? tail #b("["))
        (link-at-tail text position tail)
        'false)))
(defun link-at-tail (text position tail)
  (case (binary:match tail #b("]("))
    (`#(,delimiter-start ,2)
     (let* ((label-start (+ position 1))
            (label-end (+ position delimiter-start))
            (url-start (+ position delimiter-start 2))
            (url-tail (binary:part text url-start (- (byte_size text) url-start))))
       (case (binary:match url-tail #b(")"))
         (`#(,url-length ,1)
          (let ((url-end (+ url-start url-length)))
            (if (andalso (> label-end label-start)
                         (andalso (> url-length 0)
                                  (safe-link? (binary:part text url-start url-length))))
                `#(link ,label-start ,label-end ,url-start ,url-end ,(+ url-end 1))
                'false)))
         (_ 'false))))
    (_ 'false)))
(defun delimited (text position width delimiter kind)
  (let* ((start (+ position width))
         (tail (binary:part text start (- (byte_size text) start))))
    (case (binary:match tail (list_to_binary (list delimiter)))
      (`#(,offset ,1) (if (> offset 0) `#(,kind ,start ,(+ start offset)) 'none))
      ('true 'none))))

(defun edoc (value)
  (case value
    (binary (when (is_binary binary)) (escape binary))
    ((cons head tail) (list (edoc head) (edoc tail)))
    (() #b())
    ((tuple tag attrs children) (if (andalso (is_atom tag) (valid-attrs attrs)) (edoc-tag tag attrs children) (escape (readable value))))
    (_ (escape (readable value)))))

(defun edoc-tag (tag attrs children)
  (let* ((name (atom_to_binary tag 'utf8))
         (safe (safe-tag? tag)))
    (case safe
      ('true
       (case name
         (#b("br") #b("<br>"))
         (#b("hr") #b("<hr>"))
         (_ (list #b("<") name (edoc-attrs tag attrs) #b(">")
                                    (edoc children) #b("</") name ">"))))
      (_ (edoc children)))))

(defun safe-tag? (tag)
  (lists:member tag (list 'p 'div 'span 'a 'br 'hr 'h1 'h2 'h3 'h4 'h5 'h6 'i 'em 'b 'strong 'code 'pre 'ul 'ol 'li 'dl 'dt 'dd 'table 'thead 'tbody 'tr 'th 'td 'blockquote 'sub 'sup)))
(defun edoc-attrs (tag attrs)
  (if (=:= tag 'a)
      (iolist_to_binary (list (edoc-attr attrs 'href) (edoc-attr attrs 'title)))
      #b()))
(defun edoc-attr (attrs key)
  (case attrs
    (() #b())
    ((cons pair rest)
     (case pair
       ((tuple k value)
        (if (=:= k key)
            (case key
              ('href (if (safe-link? value) (list #b(" href=\"") (escape value) #b("\"")) #b()))
              ('title (if (is_binary value) (list #b(" title=\"") (escape value) #b("\"")) #b()))
              (_ #b()))
            (edoc-attr rest key)))
       (_ (edoc-attr rest key))))
    (_ #b())))
(defun safe-link? (value)
  (andalso (is_binary value)
           (andalso (valid-text value)
                    (andalso (not (has-control? value 0))
                    (andalso (valid-percent-triplets? value 0)
                             (safe-link-scheme? value))))))
(defun valid-percent-triplets? (value index)
  (if (>= index (byte_size value)) 'true
      (if (=:= (binary:at value index) 37)
          (andalso (< (+ index 2) (byte_size value))
                   (andalso (hex? (binary:at value (+ index 1)))
                            (andalso (hex? (binary:at value (+ index 2)))
                                     (valid-percent-triplets? value (+ index 3)))))
          (valid-percent-triplets? value (+ index 1)))))
(defun hex? (byte)
  (or (andalso (>= byte 48) (=< byte 57))
      (andalso (>= byte 65) (=< byte 70))
      (andalso (>= byte 97) (=< byte 102))))
(defun safe-link-scheme? (value)
  (case (uri_string:parse value)
    (parsed (when (is_map parsed))
     (let ((scheme (string:lowercase (binary_to_list (maps:get 'scheme parsed #b())))))
       (or (=:= scheme "http") (=:= scheme "https") (=:= scheme "mailto"))))
    (_ 'false)))
(defun has-control? (value index)
  (if (>= index (byte_size value)) 'false
      (let ((c (binary:at value index)))
        (or (< c 32) (=:= c 127) (has-control? value (+ index 1))))))
