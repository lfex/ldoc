;;;; Safe, bounded documentation rendering for static HTML.

(defmodule ldoc-markup
  "Escape text and render a bounded safe Markdown and structured EDoc subset
for the static HTML reference."
  (export
   (escape 1)
   (render 2)
   (render 3)
   (scan 1)))

(defspec (escape 1)
  ([(binary)] (binary)))

(defspec (render 2)
  ([(term) (term)]
   (UNION (tuple 'ok (binary))
          (tuple 'error 'invalid_documentation))))
(defspec (render 3)
  ([(term) (term) (map)]
   (UNION (tuple 'ok (binary)) (tuple 'error 'invalid_documentation))))
(defspec (scan 1)
  ([(binary)] (map)))

(defun escape (text)
  "Escape HTML-special characters in caller-supplied UTF-8 TEXT for safe text
or quoted-attribute placement.

The input is returned as an escaped binary. This is not a UTF-8 validator,
URL sanitizer, or redactor; callers must establish the input boundary."

  (let* ((amp (binary:replace text #b("&") #b("&amp;") (list 'global)))
         (less (binary:replace amp #b("<") #b("&lt;") (list 'global)))
         (greater (binary:replace less #b(">") #b("&gt;") (list 'global)))
         (double (binary:replace greater #b("\"") #b("&quot;") (list 'global))))
    (binary:replace double #b("'") #b("&#39;") (list 'global))))

(defun render (format value)
  "Render VALUE according to FORMAT using the supported safe documentation
subset.

UTF-8 Markdown supports documented common blocks and inline forms;
unsupported Markdown remains readable text and raw HTML is escaped.
Structured `application/erlang+html` values are checked against the allowlisted
node/attribute tree. Unknown native formats are safely printed and escaped.
Success returns `{ok, HtmlBinary}`; invalid UTF-8 Markdown or invalid structured EDoc
returns `{error, invalid_documentation}`. No full CommonMark, raw HTML execution, or remote asset
fetching is provided."

  (case format
    (#b("text/markdown")
     (case value
       (text (when (is_binary text))
        (if (valid-utf8? text)
            `#(ok ,(iolist_to_binary (markdown text)))
            '#(error invalid_documentation)))
       (_ `#(ok ,(escape (readable value))))))
    (#b("application/erlang+html")
     (case (valid-edoc? value)
       ('true `#(ok ,(iolist_to_binary (edoc value))))
       (_ '#(error invalid_documentation))))
    (_ (render-unknown value))))

(defun render (format value context)
  "Render Markdown with prepared per-document heading IDs and href mappings.
CONTEXT is an internal map from `ldoc-pages:prepare-graph/1`, containing a
heading-ID list, a resolved local-href map, and optional integer offsets/counts.
Other hrefs retain the legacy safe-link policy; malformed or untrusted context
data returns `invalid_documentation`."
  (case format
    (#b("text/markdown")
     (if (valid-context? context)
         (render-contextual-markdown value context)
         '#(error invalid_documentation)))
    (_ (render format value))))

(defun valid-context? (context)
  (andalso (is_map context)
    (andalso (lists:all (lambda (key)
                          (lists:member key '(headings links heading_offset heading_count)))
                        (maps:keys context))
      (andalso (is_list (maps:get 'headings context ()))
      (andalso (lists:all #'valid-heading-id?/1 (maps:get 'headings context ()))
      (andalso (is_map (maps:get 'links context #m()))
      (andalso (lists:all #'valid-context-link?/1 (maps:to_list (maps:get 'links context #m())))
               (valid-heading-offset? context))))))))
(defun valid-heading-offset? (context)
  (let* ((offset (maps:get 'heading_offset context 0))
         (heading-total (length (maps:get 'headings context ()))))
    (if (andalso (is_integer offset)
                 (andalso (>= offset 0) (=< offset heading-total)))
        (let ((count (case (maps:find 'heading_count context)
                       ('error (- heading-total offset))
                       (`#(ok ,value) value))))
          (andalso (is_integer count)
            (andalso (>= count 0) (=< (+ offset count) heading-total))))
        'false)))
(defun valid-heading-id? (id)
  (andalso (is_binary id)
    (andalso (>= (byte_size id) 3)
      (andalso (=:= (binary:part id 0 2) #b("h-"))
               (valid-context-bytes? id 0)))))
(defun valid-context-link? (pair)
  (case pair
    (`#(,href ,target)
     (andalso (is_binary href)
       (andalso (valid-utf8? href)
         (andalso (is_binary target) (safe-context-target? target)))))
    (_ 'false)))
(defun safe-context-target? (target)
(case target
  (#b("#main") 'true)
  (_ (case (binary:split target #b("#") (list 'global))
       ((cons #b() (cons fragment ())) (valid-context-fragment? fragment))
       ((cons route ()) (valid-context-route? route))
       ((cons route (cons fragment ()))
        (andalso (valid-context-route? route) (valid-context-fragment? fragment)))
       (_ 'false)))))
(defun valid-context-route? (route)
  (if (=:= route #b("index.html")) 'true
    (andalso (=:= (byte_size route) 71)
      (andalso (or (=:= (binary:part route 0 2) #b("p-"))
                   (=:= (binary:part route 0 2) #b("m-")))
        (andalso (=:= (binary:part route 66 5) #b(".html"))
                 (valid-route-hash? route 2))))))
(defun valid-route-hash? (route pos)
  (if (>= pos 66) 'true
    (let ((byte (binary:at route pos)))
      (andalso (or (andalso (>= byte 48) (=< byte 57))
                   (andalso (>= byte 65) (=< byte 70)))
               (valid-route-hash? route (+ pos 1))))))
(defun valid-context-fragment? (fragment)
  (andalso (>= (byte_size fragment) 3)
    (andalso (=:= (binary:part fragment 0 2) #b("h-"))
             (valid-fragment-bytes? fragment 2))))
(defun valid-fragment-bytes? (fragment pos)
  (if (>= pos (byte_size fragment)) 'true
    (let ((byte (binary:at fragment pos)))
      (if (=:= byte 37)
          (andalso (< (+ pos 2) (byte_size fragment))
            (andalso (upper-hex? (binary:at fragment (+ pos 1)))
              (andalso (upper-hex? (binary:at fragment (+ pos 2)))
                       (valid-fragment-bytes? fragment (+ pos 3)))))
          (andalso (or (andalso (>= byte 48) (=< byte 57))
                       (andalso (>= byte 97) (=< byte 122))
                       (or (=:= byte 45) (=:= byte 95)))
                   (valid-fragment-bytes? fragment (+ pos 1)))))))
(defun upper-hex? (byte)
  (or (andalso (>= byte 48) (=< byte 57))
      (andalso (>= byte 65) (=< byte 70))))
(defun has-dangerous-context-byte? (value pos)
  (if (>= pos (byte_size value)) 'false
    (let ((byte (binary:at value pos)))
      (or (or (=< byte 32) (or (=:= byte 127) (=:= byte 92)))
        (or (=:= byte 34) (or (=:= byte 60) (=:= byte 62)
                             (has-dangerous-context-byte? value (+ pos 1))))))))
(defun valid-context-bytes? (value pos)
  (if (>= pos (byte_size value)) 'true
    (let ((byte (binary:at value pos)))
      (andalso (not (or (=< byte 32) (or (=:= byte 34) (or (=:= byte 60) (=:= byte 62)))))
               (valid-context-bytes? value (+ pos 1))))))

(defun render-contextual-markdown (text context)
  (case (valid-utf8? text)
    ('false '#(error invalid_documentation))
    (_ (let* ((all-ids (maps:get 'headings context ()))
              (offset (maps:get 'heading_offset context 0))
              (count (maps:get 'heading_count context (- (length all-ids) offset)))
              (ids (lists:sublist (lists:nthtail offset all-ids) count)))
         (case (context-markdown-lines
                 (binary:split text #b("\n") (list 'global))
                 'normal context ids)
           (`#(,html ,remaining)
            (if (=:= remaining ()) `#(ok ,(iolist_to_binary html))
                '#(error invalid_documentation))))))))

(defun context-markdown-lines (lines mode context ids)
  (case lines
    (() `#(,(if (=:= mode 'fence) #b("</code></pre>") '()) ,ids))
    ((cons line rest)
     (case mode
       ('fence
        (if (prefix? line #b("```"))
            (let ((result (context-markdown-lines rest 'normal context ids)))
              `#(,(cons #b("</code></pre>") (element 1 result)) ,(element 2 result)))
            (let ((result (context-markdown-lines rest 'fence context ids)))
              `#(,(cons (list (escape line) #b("\n")) (element 1 result)) ,(element 2 result)))))
       (_ (context-markdown-line line rest context ids))))))

(defun context-markdown-line (line rest context ids)
  (cond
    ((prefix? line #b("```"))
     (let ((result (context-markdown-lines rest 'fence context ids)))
       `#(,(cons #b("<pre><code>") (element 1 result)) ,(element 2 result))))
    ((=:= line #b()) (context-markdown-lines rest 'normal context ids))
    ((table-header? line rest)
     (case rest
       ((cons _delimiter tail-lines)
        (let* ((split (lists:splitwith #'pipe-row?/1 tail-lines))
               (rows (element 1 split))
               (remaining (element 2 split))
               (table (context-render-table (table-cells line) rows context))
               (tail (context-markdown-lines remaining 'normal context ids)))
          `#(,(cons table (element 1 tail)) ,(element 2 tail))))))
    ((heading? line)
     (let* ((level (heading-level line))
            (body (binary:part line level (- (byte_size line) level)))
            (heading-result (context-heading-id ids)))
       (case heading-result
         (`#(,attribute ,remaining)
          (let ((tail (context-markdown-lines rest 'normal context remaining)))
            `#(,(cons (list #b("<h") (integer_to_binary level) attribute #b(">")
                           (inline-context (trim-left body) (maps:get 'links context #m()))
                           #b("</h") (integer_to_binary level) #b(">"))
                     (element 1 tail))
               ,(element 2 tail)))))))
    ((blockquote-item? line)
     (let* ((run (take-quote (cons line rest) '()))
            (tail-lines (drop-lines run (cons line rest)))
            (body (iolist_to_binary (join-lines (lists:map #'quote-text/1 run))))
            (rendered (inline-context body (maps:get 'links context #m())))
            (tail (context-markdown-lines tail-lines 'normal context ids)))
       `#(,(cons (list #b("<blockquote><p>") rendered #b("</p></blockquote>"))
                (element 1 tail)) ,(element 2 tail))))
    ((unordered-item? line)
     (let* ((run (take-list 'unordered (cons line rest) '()))
            (tail-lines (drop-lines run (cons line rest)))
            (items (context-list-items run context))
            (tail (context-markdown-lines tail-lines 'normal context ids)))
       `#(,(cons (list #b("<ul>") items #b("</ul>")) (element 1 tail))
          ,(element 2 tail))))
    ((ordered-item? line)
     (let* ((run (take-list 'ordered (cons line rest) '()))
            (tail-lines (drop-lines run (cons line rest)))
            (start (element 1 (ordered-item (hd run))))
            (items (context-list-items run context))
            (tail (context-markdown-lines tail-lines 'normal context ids)))
       `#(,(cons (list #b("<ol start=\"") start #b("\">") items #b("</ol>"))
                (element 1 tail)) ,(element 2 tail))))
    ('true
     (let* ((paragraph (take-paragraph (cons line rest) '()))
            (tail-lines (drop-lines paragraph (cons line rest)))
            (body (iolist_to_binary (join-lines paragraph)))
            (rendered (inline-context body (maps:get 'links context #m())))
            (tail (context-markdown-lines tail-lines 'normal context ids)))
       `#(,(cons (list #b("<p>") rendered #b("</p>")) (element 1 tail))
          ,(element 2 tail))))))

(defun context-heading-id (ids)
  (case ids
    (() `#(#b() ()))
    ((cons id rest) `#(,(list #b(" id=\"") (escape id) #b("\"")) ,rest))))
(defun context-list-items (items context)
  (case items
    (() '())
    ((cons line rest)
     (list #b("<li>") (inline-context (list-text line) (maps:get 'links context #m()))
           #b("</li>") (context-list-items rest context)))))
(defun context-render-table (headers rows context)
  (list #b("<div class=\"table-scroll\"><table><thead><tr>")
        (context-render-table-cells headers 'th context)
        #b("</tr></thead><tbody>")
        (lists:map (lambda (row) (list #b("<tr>")
                                  (context-render-table-cells (table-cells row) 'td context)
                                  #b("</tr>"))) rows)
        #b("</tbody></table></div>")))
(defun context-render-table-cells (cells tag context)
  (case cells
    (() '())
    ((cons cell rest)
     (list (if (=:= tag 'th) #b("<th>") #b("<td>"))
           (inline-context cell (maps:get 'links context #m()))
           (if (=:= tag 'th) #b("</th>") #b("</td>"))
           (context-render-table-cells rest tag context)))))
(defun inline (text links) (inline-at text 0 links))
(defun inline-context (text links) (inline text links))
(defun inline-at (text position links)
  (if (>= position (byte_size text)) #b()
      (case (match-inline text position)
        (`#(image ,start ,end ,after)
         (list (escape (binary:part text start (- end start)))
               (inline-at text after links)))
        (`#(link ,label-start ,label-end ,url-start ,url-end ,after)
         (let* ((href (binary:part text url-start (- url-end url-start)))
                (target (maps:get href links 'absent)))
           (case target
             ('absent
              (if (safe-link? href)
                  (list #b("<a href=\"") (escape href) #b("\">")
                        (inline-context (binary:part text label-start (- label-end label-start)) links)
                        #b("</a>") (inline-at text after links))
                  (list (escape (binary:part text position 1))
                        (inline-at text (+ position 1) links))))
             (_ (list #b("<a href=\"") (escape target) #b("\">")
                      (inline-context (binary:part text label-start (- label-end label-start)) links)
                      #b("</a>") (inline-at text after links))))))
        (`#(code ,start ,end ,after)
         (list #b("<code>") (escape (binary:part text start (- end start)))
               #b("</code>") (inline-at text after links)))
        (`#(strong ,start ,end ,after)
         (list #b("<strong>") (inline-context (binary:part text start (- end start)) links)
               #b("</strong>") (inline-at text after links)))
        (`#(em ,start ,end ,after)
         (list #b("<em>") (inline-context (binary:part text start (- end start)) links)
               #b("</em>") (inline-at text after links)))
        (_ (let ((width (utf8-width text position)))
             (list (escape (binary:part text position width))
                   (inline-at text (+ position width) links)))))))

(defun scan (text)
  "Inspect headings and syntactic inline links using the Markdown recognizer."
  (case (valid-utf8? text)
    ('false `#m(headings () links ()))
    (_ (let* ((lines (binary:split text #b("\n") (list 'global)))
              (`#(,headings ,links) (scan-lines lines 'normal '() '())))
         `#m(headings ,(lists:reverse headings) links ,(lists:reverse links))))))

(defun scan-lines (lines mode headings links)
  (case lines
    (() `#(,headings ,links))
    ((cons line rest)
     (case mode
       ('fence (if (prefix? line #b("```"))
                   (scan-lines rest 'normal headings links)
                   (scan-lines rest 'fence headings links)))
       (_ (if (prefix? line #b("```"))
              (scan-lines rest 'fence headings links)
              (let* ((level (heading-level line))
                     (heading (if (is_integer level)
                                  (tuple level (inline-plain
                                    (trim-left (binary:part line level
                                      (- (byte_size line) level)))))
                                  'none))
                     (new-headings (case heading
                       (`#(,n ,label) (cons (tuple n label) headings))
                       (_ headings)))
                     (new-links (lists:append (scan-inline-links line 0 '()) links)))
                (scan-lines rest 'normal new-headings new-links))))))))

(defun scan-inline-links (text pos reversed)
  (if (>= pos (byte_size text)) reversed
      (case (match-inline text pos)
        (`#(link ,_ls ,_le ,us ,ue ,after)
         (scan-inline-links text after
           (cons (binary:part text us (- ue us)) reversed)))
        (`#(code ,_s ,_e ,after) (scan-inline-links text after reversed))
        (`#(strong ,s ,e ,after)
         (scan-inline-links text after
           (lists:append (scan-inline-links (binary:part text s (- e s)) 0 '()) reversed)))
        (`#(em ,s ,e ,after)
         (scan-inline-links text after
           (lists:append (scan-inline-links (binary:part text s (- e s)) 0 '()) reversed)))
        (`#(image ,_s ,_e ,after) (scan-inline-links text after reversed))
        (_ (scan-inline-links text (+ pos (utf8-width text pos)) reversed)))))

(defun inline-plain (text)
  (iolist_to_binary (inline-plain-at text 0)))
(defun inline-plain-at (text pos)
  (if (>= pos (byte_size text)) '()
      (case (match-inline text pos)
        (`#(link ,ls ,le ,_us ,_ue ,after)
         (cons (inline-plain (binary:part text ls (- le ls)))
               (inline-plain-at text after)))
        (`#(image ,ls ,le ,after)
         (cons (binary:part text ls (- le ls)) (inline-plain-at text after)))
        (`#(code ,s ,e ,after)
         (cons (binary:part text s (- e s)) (inline-plain-at text after)))
        (`#(strong ,s ,e ,after)
         (cons (inline-plain (binary:part text s (- e s))) (inline-plain-at text after)))
        (`#(em ,s ,e ,after)
         (cons (inline-plain (binary:part text s (- e s))) (inline-plain-at text after)))
        (_ (let ((width (utf8-width text pos)))
             (cons (binary:part text pos width)
                   (inline-plain-at text (+ pos width))))))))

(defun render-unknown (value)
  (case value
    (text (when (is_binary text))
     (if (valid-utf8? text)
         `#(ok ,(escape text))
         '#(error invalid_documentation)))
    (_ `#(ok ,(escape (readable value))))))

(defun readable (value)
  (case value
    (binary (when (is_binary binary)) binary)
    (_ (unicode:characters_to_binary (lfe_io:print1 value) 'utf8 'utf8))))

(defun valid-utf8? (text)
  (case (unicode:characters_to_binary text 'utf8 'utf8)
    (converted (when (is_binary converted)) 'true)
    (_ 'false)))

(defun valid-edoc? (value)
  (case value
    (text (when (is_binary text)) (valid-utf8? text))
    (() 'true)
    ((cons _ _) (valid-edoc-list? value))
    (tuple-value (when (is_tuple tuple-value))
     (if (andalso (=:= (tuple_size tuple-value) 3)
                  (is_atom (element 1 tuple-value)))
         (andalso (valid-edoc-attrs (element 2 tuple-value))
                  (valid-edoc? (element 3 tuple-value)))
         'true))
    (_ 'true)))
(defun valid-edoc-list? (items)
  (case items
    (() 'true)
    ((cons item rest) (andalso (valid-edoc? item) (valid-edoc-list? rest)))
    (_ 'false)))
(defun valid-edoc-attrs (attrs)
  (case attrs
    (() 'true)
    ((cons item rest)
     (case item
       ((tuple key value)
        (andalso (is_atom key)
                 (andalso (is_binary value)
                          (andalso (valid-utf8? value) (valid-edoc-attrs rest)))))
       (_ 'false)))
    (_ 'false)))

(defun markdown (text)
  (markdown-lines (binary:split text #b("\n") (list 'global)) 'normal))
(defun markdown-lines (lines mode)
  (case lines
    (() (if (=:= mode 'fence) #b("</code></pre>") '()))
    ((cons line rest)
     (case mode
       ('fence
        (if (prefix? line #b("```"))
            (cons #b("</code></pre>") (markdown-lines rest 'normal))
            (cons (list (escape line) #b("\n"))
                  (markdown-lines rest 'fence))))
       (_ (markdown-line line rest))))))

(defun markdown-line (line rest)
  (cond
    ((table-header? line rest)
     (case rest
       ((cons _delimiter tail)
        (let* ((split (lists:splitwith #'pipe-row?/1 tail))
               (rows (element 1 split))
               (remaining (element 2 split)))
          (cons (render-table (table-cells line) rows)
                (markdown-lines remaining 'normal))))))
    ((prefix? line #b("```"))
     (cons #b("<pre><code>") (markdown-lines rest 'fence)))
    ((=:= line #b()) (markdown-lines rest 'normal))
    ((heading? line)
     (let* ((level (heading-level line))
            (body (binary:part line level (- (byte_size line) level))))
       (cons (list #b("<h") (integer_to_binary level) #b(">")
                   (inline (trim-left body)) #b("</h") (integer_to_binary level) #b(">"))
             (markdown-lines rest 'normal))))
    ((blockquote-item? line)
     (let* ((run (take-quote (cons line rest) '()))
            (tail (drop-lines run (cons line rest))))
       (cons (list #b("<blockquote><p>")
                   (inline (iolist_to_binary (join-lines (lists:map #'quote-text/1 run))))
                   #b("</p></blockquote>"))
             (markdown-lines tail 'normal))))
    ((unordered-item? line)
     (let* ((run (take-list 'unordered (cons line rest) '()))
            (tail (drop-lines run (cons line rest))))
       (cons (list #b("<ul>") (render-unordered-items run) #b("</ul>"))
             (markdown-lines tail 'normal))))
    ((ordered-item? line)
     (let* ((run (take-list 'ordered (cons line rest) '()))
            (tail (drop-lines run (cons line rest)))
            (start (element 1 (ordered-item (hd run)))))
       (cons (list #b("<ol start=\"") start #b("\">")
                   (render-ordered-items run) #b("</ol>"))
             (markdown-lines tail 'normal))))
    ('true
     (let ((paragraph (take-paragraph (cons line rest) '())))
       (cons (list #b("<p>")
                   (inline (iolist_to_binary (join-lines paragraph)))
                   #b("</p>"))
             (markdown-lines (drop-lines paragraph (cons line rest)) 'normal))))))

(defun table-header? (line rest)
  (case rest
    ((cons delimiter _) (andalso (pipe-row? line)
                                 (andalso (pipe-row? delimiter)
                                          (table-delimiter? delimiter))))
    (_ 'false)))
(defun pipe-row? (line)
  (andalso (> (byte_size line) 1)
           (andalso (=:= (binary:at line 0) 124)
                    (=:= (binary:at line (- (byte_size line) 1)) 124))))
(defun table-delimiter? (line) (table-delimiter-at? line 0 'false))
(defun table-delimiter-at? (line index dash-seen)
  (if (>= index (byte_size line)) dash-seen
      (let ((byte (binary:at line index)))
        (if (or (=:= byte 124) (=:= byte 45) (=:= byte 58) (=:= byte 32))
            (table-delimiter-at? line (+ index 1) (or dash-seen (=:= byte 45)))
            'false))))
(defun table-cells (line)
  (let* ((parts (binary:split line #b("|") (list 'global)))
         (without-leading (if (=:= (hd parts) #b()) (lists:nthtail 1 parts) parts))
         (middle (if (=:= (lists:last without-leading) #b())
                     (lists:sublist without-leading (- (length without-leading) 1))
                     without-leading)))
    (lists:map #'trim-cell/1 middle)))
(defun trim-cell (cell) (trim-right (trim-left cell)))
(defun trim-right (cell)
  (if (andalso (> (byte_size cell) 0)
               (=:= (binary:at cell (- (byte_size cell) 1)) 32))
      (trim-right (binary:part cell 0 (- (byte_size cell) 1)))
      cell))
(defun render-table (headers rows)
  (list #b("<div class=\"table-scroll\"><table><thead><tr>")
        (render-table-cells headers 'th)
        #b("</tr></thead><tbody>")
        (lists:map #'render-table-row/1 rows)
        #b("</tbody></table></div>")))
(defun render-table-row (line)
  (list #b("<tr>") (render-table-cells (table-cells line) 'td) #b("</tr>")))
(defun render-table-cells (cells tag)
  (case cells
    (() '())
    ((cons cell rest)
     (list (if (=:= tag 'th) #b("<th>") #b("<td>"))
           (inline cell)
           (if (=:= tag 'th) #b("</th>") #b("</td>"))
           (render-table-cells rest tag)))))

(defun heading? (line) (is_integer (heading-level line)))
(defun heading-level (line) (heading-level-at line 0))
(defun heading-level-at (line count)
  (if (andalso (< count 6)
               (andalso (> (byte_size line) count)
                        (=:= (binary:at line count) 35)))
      (heading-level-at line (+ count 1))
      (if (andalso (> count 0)
                   (andalso (< count 7)
                            (andalso (> (byte_size line) count)
                                     (=:= (binary:at line count) 32))))
          count 'false)))
(defun prefix? (text prefix)
  (andalso (>= (byte_size text) (byte_size prefix))
           (=:= (binary:part text 0 (byte_size prefix)) prefix)))

(defun blockquote-item? (line)
  (or (prefix? line #b("> ")) (=:= line #b(">"))))
(defun quote-text (line)
  (if (=:= line #b(">")) #b()
      (binary:part line 2 (- (byte_size line) 2))))
(defun take-quote (lines acc)
  (case lines
    ((cons line rest)
     (if (blockquote-item? line)
         (take-quote rest (cons line acc))
         (lists:reverse acc)))
    (_ (lists:reverse acc))))
(defun unordered-marker (line)
  (cond ((prefix? line #b("- ")) 45)
        ((prefix? line #b("* ")) 42)
        ((prefix? line #b("+ ")) 43)
        ('true 'false)))
(defun unordered-item? (line) (is_integer (unordered-marker line)))
(defun ordered-item? (line) (is_tuple (ordered-item line)))
(defun list-kind (line)
  (if (unordered-item? line) 'unordered
      (if (ordered-item? line) 'ordered 'none)))
(defun list-text (line)
  (case (unordered-marker line)
    (marker (when (is_integer marker))
     (binary:part line 2 (- (byte_size line) 2)))
    (_ (element 2 (ordered-item line)))))
(defun take-list (kind lines acc)
  (case lines
    ((cons line rest)
     (if (=:= (list-kind line) kind)
         (take-list kind rest (cons line acc))
         (lists:reverse acc)))
    (_ (lists:reverse acc))))
(defun render-unordered-items (items)
  (case items
    (() '())
    ((cons line rest)
     (list #b("<li>") (inline (list-text line)) #b("</li>")
           (render-unordered-items rest)))))
(defun render-ordered-items (items)
  (case items
    (() '())
    ((cons line rest)
     (list #b("<li>") (inline (list-text line)) #b("</li>")
           (render-ordered-items rest)))))
(defun ordered-item (line)
  (case (binary:match line #b(". "))
    (`#(,position ,2)
     (let ((digits (binary:part line 0 position)))
       (if (andalso (all-digits? digits) (> position 0))
           `#(,digits
              ,(binary:part line (+ position 2) (- (byte_size line) (+ position 2))))
           'false)))
    (_ 'false)))
(defun all-digits? (value)
  (andalso (> (byte_size value) 0) (all-digits-at? value 0)))
(defun all-digits-at? (value index)
  (if (>= index (byte_size value)) 'true
      (let ((byte (binary:at value index)))
        (andalso (>= byte 48) (andalso (=< byte 57)
                                      (all-digits-at? value (+ index 1)))))))
(defun trim-left (value)
  (if (andalso (> (byte_size value) 0) (=:= (binary:at value 0) 32))
      (binary:part value 1 (- (byte_size value) 1)) value))
(defun take-paragraph (lines acc)
  (case lines
    (() (lists:reverse acc))
    ((cons line rest)
     (if (or (=:= line #b()) (prefix? line #b("```")) (heading? line)
             (blockquote-item? line) (unordered-item? line) (ordered-item? line))
         (lists:reverse acc)
         (take-paragraph rest (cons line acc))))))
(defun drop-lines (taken lines)
  (lists:nthtail (length taken) lines))
(defun join-lines (lines)
  (case lines
    (() #b())
    ((cons line ()) line)
    ((cons line rest) (list line #b(" ") (join-lines rest)))))

(defun inline (text) (inline-at text 0))
(defun inline-at (text position)
  (if (>= position (byte_size text)) #b()
      (case (match-inline text position)
        (`#(image ,start ,end ,after)
         (list (escape (binary:part text start (- end start)))
               (inline-at text after)))
        (`#(link ,label-start ,label-end ,url-start ,url-end ,after)
         (if (safe-link? (binary:part text url-start (- url-end url-start)))
             (list #b("<a href=\"")
                   (escape (binary:part text url-start (- url-end url-start)))
                   #b("\">")
                   (inline (binary:part text label-start (- label-end label-start)))
                   #b("</a>")
                   (inline-at text after))
             (list (escape (binary:part text position 1))
                   (inline-at text (+ position 1)))))
        (`#(code ,start ,end ,after)
         (list #b("<code>") (escape (binary:part text start (- end start)))
               #b("</code>") (inline-at text after)))
        (`#(strong ,start ,end ,after)
         (list #b("<strong>") (inline (binary:part text start (- end start)))
               #b("</strong>") (inline-at text after)))
        (`#(em ,start ,end ,after)
         (list #b("<em>") (inline (binary:part text start (- end start)))
               #b("</em>") (inline-at text after)))
        (_ (let ((width (utf8-width text position)))
             (list (escape (binary:part text position width))
                   (inline-at text (+ position width))))))))
(defun utf8-width (text position)
  (let ((byte (binary:at text position)))
    (cond ((< byte 128) 1) ((< byte 224) 2) ((< byte 240) 3) ('true 4))))
(defun match-inline (text position)
  (let ((image (image-at text position)))
    (if (is_tuple image) image
        (let ((link (link-at text position)))
          (if (is_tuple link) link (match-inline-delimited text position))))))
(defun match-inline-delimited (text position)
  (let ((rest (binary:part text position (- (byte_size text) position))))
    (cond ((prefix? rest #b("`")) (delimited text position #b("`") 'code))
          ((prefix? rest #b("**")) (delimited text position #b("**") 'strong))
          ((prefix? rest #b("*")) (delimited text position #b("*" ) 'em))
          ('true 'none))))
(defun delimited (text position delimiter kind)
  (let* ((width (byte_size delimiter))
         (start (+ position width))
         (closing (find-delimiter text delimiter start kind)))
    (case closing
      ('none 'none)
      (`#(,end ,after)
       (if (> end start) `#(,kind ,start ,end ,after) 'none)))))
(defun find-delimiter (text delimiter from kind)
  (if (>= from (byte_size text)) 'none
      (let ((tail (binary:part text from (- (byte_size text) from))))
        (case (binary:match tail delimiter)
          (`#(,offset ,length)
           (let ((position (+ from offset)))
             (if (exact-emphasis-delimiter? text position length kind)
                 `#(,position ,(+ position length))
                 (find-delimiter text delimiter (+ position length) kind))))
          (_ 'none)))))
(defun exact-emphasis-delimiter? (text position length kind)
  (if (or (=:= kind 'em) (=:= kind 'strong))
      (andalso (left-delimiter-boundary? text position)
               (right-delimiter-boundary? text (+ position length)))
      'true))
(defun left-delimiter-boundary? (text position)
  (if (=:= position 0) 'true
      (not (=:= (binary:at text (- position 1)) 42))))
(defun right-delimiter-boundary? (text position)
  (if (=:= position (byte_size text)) 'true
      (not (=:= (binary:at text position) 42))))
(defun image-at (text position)
  (if (andalso (< (+ position 1) (byte_size text))
               (andalso (=:= (binary:at text position) 33)
                        (=:= (binary:at text (+ position 1)) 91)))
      (let* ((label-start (+ position 2))
             (tail (binary:part text label-start (- (byte_size text) label-start))))
        (case (binary:match tail #b("]("))
          (`#(,label-length ,2)
           (let* ((label-end (+ label-start label-length))
                  (url-start (+ label-end 2))
                  (url-tail (binary:part text url-start (- (byte_size text) url-start))))
             (case (binary:match url-tail #b(")"))
               (`#(,url-length ,1)
                `#(image ,label-start ,label-end ,(+ url-start url-length 1)))
               (_ 'false))))
          (_ 'false)))
      'false))
(defun link-at (text position)
  (if (=:= (binary:at text position) 91)
      (link-at-tail text position (binary:part text position (- (byte_size text) position)))
      'false))
(defun link-at-tail (text position tail)
  (case (binary:match tail #b("]("))
    (`#(,delimiter-start ,2)
     (let* ((label-start (+ position 1))
            (label-end (+ position delimiter-start))
            (url-start (+ position delimiter-start 2))
            (url-tail (binary:part text url-start (- (byte_size text) url-start))))
       (case (binary:match url-tail #b(")"))
         (`#(,url-length ,1)
          (let ((url-end (+ url-start url-length)))
            (if (andalso (> label-end label-start) (> url-length 0))
                `#(link ,label-start ,label-end ,url-start ,url-end ,(+ url-end 1))
                'false)))
         (_ 'false))))
    (_ 'false)))

(defun safe-link? (value)
  (andalso (is_binary value)
           (andalso (valid-utf8? value)
                    (andalso (not (has-uri-space-or-control? value 0))
                             (andalso (not (has-backslash? value 0))
                                      (andalso (valid-percent-triplets? value 0)
                                               (andalso (not (empty-link-port? value))
                                                        (safe-link-uri? value))))))))
(defun has-control? (value index)
  (if (>= index (byte_size value)) 'false
      (let ((byte (binary:at value index)))
        (or (< byte 32) (=:= byte 127) (has-control? value (+ index 1))))))
(defun has-uri-space-or-control? (value index)
  (if (>= index (byte_size value)) 'false
      (let ((byte (binary:at value index)))
        (or (=< byte 32) (=:= byte 127)
            (has-uri-space-or-control? value (+ index 1))))))
(defun has-backslash? (value index)
  (if (>= index (byte_size value)) 'false
      (or (=:= (binary:at value index) 92)
          (has-backslash? value (+ index 1)))))
(defun valid-percent-triplets? (value index)
  (if (>= index (byte_size value)) 'true
      (if (=:= (binary:at value index) 37)
          (andalso (< (+ index 2) (byte_size value))
                   (andalso (hex? (binary:at value (+ index 1)))
                            (andalso (hex? (binary:at value (+ index 2)))
                                     (valid-percent-triplets? value (+ index 3)))))
          (valid-percent-triplets? value (+ index 1)))))
(defun hex? (byte)
  (or (andalso (>= byte 48) (=< byte 57))
      (or (andalso (>= byte 65) (=< byte 70))
          (andalso (>= byte 97) (=< byte 102)))))
(defun safe-link-uri? (value)
  (case (uri_string:parse value)
    (parsed (when (is_map parsed))
     (let* ((scheme (string:lowercase (binary_to_list (maps:get 'scheme parsed #b()))))
            (host (maps:get 'host parsed #b()))
            (path (maps:get 'path parsed #b()))
            (port (maps:get 'port parsed 'absent)))
       (case scheme
         ("http" (andalso (is_binary host)
                          (andalso (> (byte_size host) 0)
                                   (valid-link-port? port))))
         ("https" (andalso (is_binary host)
                           (andalso (> (byte_size host) 0)
                                    (valid-link-port? port))))
         ("mailto" (andalso (is_binary path) (> (byte_size path) 0)))
         (_ 'false))))
    (_ 'false)))
(defun valid-link-port? (port)
  (or (=:= port 'absent)
      (andalso (is_integer port) (andalso (>= port 0) (=< port 65535)))))
(defun empty-link-port? (value)
  (case (binary:match value #b("://"))
    (`#(,separator ,3)
     (let* ((tail-start (+ separator 3))
            (tail (binary:part value tail-start
                               (- (byte_size value) tail-start)))
            (slash (binary:match tail #b("/")))
            (authority-end (case slash
                             (`#(,position ,1) position)
                             (_ (byte_size tail))))
            (authority (binary:part tail 0 authority-end)))
       (andalso (> (byte_size authority) 0)
                (=:= (binary:at authority (- (byte_size authority) 1)) 58))))
    (_ 'false)))

(defun edoc (value)
  (case value
    (text (when (is_binary text)) (escape text))
    (() #b())
    ((cons head tail) (list (edoc head) (edoc tail)))
    (tuple-value (when (is_tuple tuple-value))
     (if (andalso (=:= (tuple_size tuple-value) 3)
                  (is_atom (element 1 tuple-value)))
         (edoc-node (element 1 tuple-value) (element 2 tuple-value)
                    (element 3 tuple-value))
         (escape (readable tuple-value))))
    (_ (escape (readable value)))))
(defun edoc-node (tag attrs children)
  (let ((name (atom_to_binary tag 'utf8)))
    (case (safe-tag? tag)
      ('true
       (case tag
         ('br #b("<br>"))
         ('hr #b("<hr>"))
         (_ (list #b("<") name (edoc-attrs tag attrs) #b(">")
                  (edoc children) #b("</") name #b(">")))))
      (_ (edoc children)))))
(defun safe-tag? (tag)
  (lists:member tag
    '(p div span a br hr h1 h2 h3 h4 h5 h6 i em b strong code pre
      ul ol li dl dt dd table thead tbody tr th td blockquote sub sup)))
(defun edoc-attrs (tag attrs)
  (if (=:= tag 'a)
      (list (edoc-attr attrs 'href) (edoc-attr attrs 'title))
      #b()))
(defun edoc-attr (attrs key)
  (case attrs
    (() #b())
    ((cons pair rest)
     (case pair
       ((tuple attr-key value)
        (if (=:= attr-key key)
            (case key
              ('href (if (safe-link? value)
                         (list #b(" href=\"") (escape value) #b("\"")) #b()))
              ('title (list #b(" title=\"") (escape value) #b("\"")))
              (_ #b()))
            (edoc-attr rest key)))
       (_ #b())))
    (_ #b())))
