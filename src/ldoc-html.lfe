;;;; Pure deterministic static HTML rendering for selected analysis views.

(defmodule ldoc-html
  (export
   (render 1)
   (render 2)
   (valid-options? 1)))

(defspec (render 1)
  ([(term)] (UNION (tuple 'ok (list (tuple (binary) (binary))))
                   (tuple 'error 'invalid_view))))
(defspec (render 2)
  ([(term) (term)] (UNION (tuple 'ok (list (tuple (binary) (binary))))
                          (tuple 'error (UNION 'invalid_options 'invalid_view)))))

(defspec (valid-options? 1)
  ([(term)] (boolean)))

(defun valid-options? (options)
  "Return whether OPTIONS would be accepted by render/2."
  (case (validate-options options)
    (`#(ok ,_) 'true)
    (_ 'false)))

(defun render (view)
  "Render VIEW with default options into sorted relative filename/byte pairs."
  (render view #m()))

(defun render (view options)
  "Validate options and the complete selected view, then return a pure HTML bundle."
  (case (validate-options options)
    ('false '#(error invalid_options))
    (`#(ok ,opts)
     (case (validate-view view)
       ('false '#(error invalid_view))
       (`#(ok ,canonical)
        `#(ok ,(bundle canonical opts)))))))

(defun validate-options (options)
  (if (andalso (is_map options)
               (all-keys? (maps:keys options)
                          '(locale overview source_base version_index))
               (valid-locale? (maps:get 'locale options #b("en")))
               (andalso (valid-overview? (maps:get 'overview options #b()))
                        (is_boolean (maps:get 'version_index options 'false))))
      (case (maps:find 'source_base options)
        ('error `#(ok ,(canonical-options options)))
        (`#(ok ,base) (if (valid-source-base? base)
                          `#(ok ,(canonical-options options)) 'false)))
      'false))

(defun canonical-options (options)
  `#m(locale ,(maps:get 'locale options #b("en"))
      overview ,(maps:get 'overview options #b())
      source_base ,(maps:get 'source_base options 'none)
      version_index ,(maps:get 'version_index options 'false)))
(defun all-keys? (keys allowed)
  (case keys
    (() 'true)
    ((cons key rest) (andalso (lists:member key allowed) (all-keys? rest allowed)))
    (_ 'false)))
(defun valid-locale? (locale)
  (andalso (is_binary locale) (> (byte_size locale) 0) (valid-utf8? locale)))
(defun valid-overview? (overview)
  (andalso (is_binary overview)
           (andalso (valid-utf8? overview)
                    (case (ldoc-markup:render #b("text/markdown") overview)
                      (`#(ok ,_html) 'true)
                      (_ 'false)))))
(defun valid-utf8? (binary)
  (andalso (is_binary binary)
           (case (unicode:characters_to_binary binary 'utf8 'utf8)
             (value (when (is_binary value)) 'true)
             (_ 'false))))

(defun valid-source-base? (base)
  (andalso (is_binary base)
           (> (byte_size base) 0)
           (valid-utf8? base)
           (not (has-forbidden-uri-byte? base 0))
           (valid-percent-triplets? base 0)
           (uri-structure? base)))
(defun has-forbidden-uri-byte? (base index)
  (if (>= index (byte_size base)) 'false
      (let ((c (binary:at base index)))
        (or (=< c 32) (=:= c 127) (=:= c 92)
            (has-forbidden-uri-byte? base (+ index 1))))))
(defun valid-percent-triplets? (base index)
  (if (>= index (byte_size base)) 'true
      (if (=:= (binary:at base index) 37)
          (andalso (< (+ index 2) (byte_size base))
                   (hex-digit? (binary:at base (+ index 1)))
                   (hex-digit? (binary:at base (+ index 2)))
                   (valid-percent-triplets? base (+ index 3)))
          (valid-percent-triplets? base (+ index 1)))))
(defun hex-digit? (c)
  (or (andalso (>= c 48) (=< c 57))
      (andalso (>= c 65) (=< c 70))
      (andalso (>= c 97) (=< c 102))))
(defun uri-structure? (base)
  (let ((parsed (uri_string:parse base)))
    (if (is_map parsed)
        (let* ((scheme (maps:get 'scheme parsed #b()))
               (host (maps:get 'host parsed #b()))
               (path (maps:get 'path parsed #b()))
               (port (maps:get 'port parsed 'absent))
               (scheme-lower (string:lowercase (binary_to_list scheme))))
          (lists:all (lambda (valid) valid)
                     (list (or (=:= scheme-lower "http") (=:= scheme-lower "https"))
                           (is_binary host) (> (byte_size host) 0)
                           (is_binary path) (ends-slash? path)
                           (not (maps:is_key 'userinfo parsed))
                           (not (maps:is_key 'query parsed))
                           (not (maps:is_key 'fragment parsed))
                           (valid-explicit-port? port)
                           (not (empty-explicit-port? base)))))
        'false)))
(defun valid-explicit-port? (port)
  (or (=:= port 'absent)
      (andalso (is_integer port) (andalso (>= port 0) (=< port 65535)))))
(defun empty-explicit-port? (base)
  (case (binary:match base #b("://"))
    (`#(,separator ,3)
     (let* ((tail-start (+ separator 3))
            (tail (binary:part base tail-start
                               (- (byte_size base) tail-start)))
            (slash (binary:match tail #b("/")))
            (authority-end (case slash
                             (`#(,position ,1) position)
                             (_ (byte_size tail))))
            (authority (binary:part tail 0 authority-end)))
       (andalso (> (byte_size authority) 0)
                (=:= (binary:at authority (- (byte_size authority) 1)) 58))))
    (_ 'false)))
(defun ends-slash? (path)
  (andalso (> (byte_size path) 0) (=:= (binary:at path (- (byte_size path) 1)) 47)))

(defun validate-view (view)
  (if (andalso (is_map view)
               (=:= (lists:sort (maps:keys view)) '(languages release))
               (valid-release (maps:get 'release view))
               (proper-list? (maps:get 'languages view)))
      (case (validated-languages (maps:get 'languages view))
        ('invalid 'false)
        (languages
         (if (=:= languages ())
             'false
             (if (not (unique-by languages #'language-name/1))
                 'false
                 (if (not (unique-by (flatten-modules languages)
                                     #'module-identity-name/1))
                     'false
                     `#(ok ,(maps:from_list
                              (list (tuple 'release (maps:get 'release view))
                                    (tuple 'languages
                                      (lists:sort
                                        (lambda (a b) (< (maps:get 'name a)
                                                         (maps:get 'name b)))
                                        languages))))))))))
      'false))
(defun valid-release (release)
  (andalso (is_map release)
           (=:= (lists:sort (maps:keys release)) '(namespace package version))
           (valid-nonempty-utf8? (maps:get 'namespace release))
           (valid-nonempty-utf8? (maps:get 'package release))
           (valid-nonempty-utf8? (maps:get 'version release))))
(defun valid-nonempty-utf8? (value)
  (andalso (is_binary value)
           (> (byte_size value) 0)
           (valid-utf8? value)))
(defun proper-list? (value)
  (case value
    (() 'true)
    ((cons _ rest) (proper-list? rest))
    (_ 'false)))
(defun unique-by (items keyfun)
  (unique-by items keyfun #m()))
(defun unique-by (items keyfun seen)
  (case items
    (() 'true)
    ((cons item rest)
     (let ((key (funcall keyfun item)))
       (if (maps:is_key key seen) 'false
           (unique-by rest keyfun (maps:put key 'true seen)))))
    (_ 'false)))
(defun language-name (language) (maps:get 'name language))
(defun module-identity-name (item) (maps:get 'name (element 2 item)))
(defun validated-languages (languages)
  (case languages
    (() ())
    ((cons lang rest)
     (case (validate-language lang)
       ('false 'invalid)
       (valid (let ((tail-values (validated-languages rest)))
                (if (=:= tail-values 'invalid) 'invalid
                    (cons valid tail-values))))))
    (_ 'invalid)))
(defun validate-language (lang)
  (if (andalso (is_map lang)
               (andalso (=:= (lists:sort (maps:keys lang)) '(modules name))
                        (andalso (valid-nonempty-utf8? (maps:get 'name lang))
                                 (proper-list? (maps:get 'modules lang)))))
      (let ((modules (validated-modules (maps:get 'modules lang))))
        (case modules
          ('invalid 'false)
          (_ (if (not (unique-by modules #'module-name/1))
                 'false
                 (maps:from_list
                   (list (tuple 'name (maps:get 'name lang))
                         (tuple 'modules (lists:sort
                           (lambda (a b) (< (maps:get 'name a) (maps:get 'name b)))
                           modules))))))))
      'false))
(defun module-name (module) (maps:get 'name module))
(defun validated-modules (modules)
  (case modules
    (() ())
    ((cons module rest)
     (case (validate-module module)
       ('false 'invalid)
       (valid (let ((tail-values (validated-modules rest)))
                (if (=:= tail-values 'invalid) 'invalid
                    (cons valid tail-values))))))
    (_ 'invalid)))
(defun validate-module (module)
  (if (valid-module-shape? module)
      (validate-module-definitions module)
      'false))
(defun valid-module-shape? (module)
  (andalso (is_map module)
           (required-optional-keys? module
                                    '(name format doc definitions)
                                    '(source))
           (valid-nonempty-utf8? (maps:get 'name module))
           (valid-nonempty-utf8? (maps:get 'format module))
           (valid-doc-for-format (maps:get 'format module)
                                 (maps:get 'doc module))
           (proper-list? (maps:get 'definitions module))
           (valid-optional-source? module)))
(defun validate-module-definitions (module)
  (let ((definitions (validated-definitions (maps:get 'format module)
                                            (maps:get 'definitions module))))
    (case definitions
      ('invalid 'false)
      (_ (if (valid-module-definitions? module definitions)
             (maps:put 'definitions
                       (lists:sort (lambda (a b) (< (definition-identity a)
                                                    (definition-identity b)))
                                   definitions)
                       module)
             'false)))))
(defun valid-module-definitions? (module definitions)
  (andalso (unique-by definitions #'definition-identity/1)
           (if (=:= (maps:get 'doc module) 'hidden)
               (andalso (=:= definitions ())
                        (not (maps:is_key 'source module)))
               'true)))
(defun required-optional-keys? (map required optional)
  (andalso (lists:all (lambda (key) (maps:is_key key map)) required)
           (all-keys? (maps:keys map) (lists:append required optional))))
(defun valid-doc-for-format (format doc)
  (case doc
    ('none 'true)
    ('hidden 'true)
    (doc-map (when (is_map doc-map))
     (valid-doc-map format (maps:to_list doc-map)))
    (_ 'false)))
(defun valid-doc-map (format pairs)
  (case pairs
    (() 'true)
    ((cons pair rest)
     (case pair
       ((tuple key value)
        (andalso (valid-utf8? key)
                 (andalso (doc-renderable? format value)
                          (valid-doc-map format rest))))
       (_ 'false)))
    (_ 'false)))
(defun doc-renderable? (format value)
  (case (ldoc-markup:render format value)
    (`#(ok ,_html) 'true)
    (_ 'false)))
(defun valid-optional-source? (map)
  (case (maps:find 'source map)
    ('error 'true)
    (`#(ok ,source) (valid-source source))))
(defun valid-source (source)
  (if (is_map source)
      (andalso (all-keys? (maps:keys source) '(path line))
               (maps:is_key 'path source)
               (safe-relative-path? (maps:get 'path source))
               (case (maps:find 'line source)
                 ('error 'true)
                 (`#(ok ,line) (andalso (is_integer line) (> line 0)))))
      'false))
(defun has-control? (value index)
  (if (>= index (byte_size value)) 'false
      (let ((byte (binary:at value index)))
        (or (< byte 32) (=:= byte 127)
            (has-control? value (+ index 1))))))
(defun safe-relative-path? (path)
  (andalso (is_binary path)
           (> (byte_size path) 0)
           (valid-utf8? path)
           (not (=:= (binary:at path 0) 47))
           (not (has-control? path 0))
           (proper-path-components?
             (binary:split path #b("/") (list 'global)))))
(defun proper-path-components? (parts)
  (case parts
    (() 'true)
    ((cons part rest)
     (andalso (> (byte_size part) 0)
              (andalso (not (=:= part #b(".")))
                       (andalso (not (=:= part #b("..")))
                                (proper-path-components? rest)))))
    (_ 'false)))
(defun validated-definitions (format definitions)
  (case definitions
    (() ())
    ((cons definition rest)
     (case (validate-definition format definition)
       ('false 'invalid)
       (valid (let ((tail-values (validated-definitions format rest)))
                (if (=:= tail-values 'invalid) 'invalid
                    (cons valid tail-values))))))
    (_ 'invalid)))
(defun validate-definition (format definition)
  (if (andalso (is_map definition)
               (required-optional-keys? definition
                                        '(kind name arity signatures doc)
                                        '(patterns source))
               (valid-nonempty-utf8? (maps:get 'kind definition))
               (valid-nonempty-utf8? (maps:get 'name definition))
               (valid-arity (maps:get 'arity definition))
               (valid-signatures (maps:get 'signatures definition))
               (valid-doc-for-format format (maps:get 'doc definition))
               (valid-optional-source? definition))
      definition
      'false))
(defun valid-signatures (signatures)
  (andalso (proper-list? signatures)
           (lists:all #'valid-utf8?/1 signatures)))
(defun valid-arity (arity)
  (or (=:= arity 'unknown) (andalso (is_integer arity) (>= arity 0))))
(defun definition-identity (definition)
  `#(,(maps:get 'kind definition) ,(maps:get 'name definition)
      ,(maps:get 'arity definition)))
(defun arity-text (arity)
  (case arity
    ('unknown #b("unknown"))
    (number (when (is_integer number)) (erlang:integer_to_binary number))))

(defun bundle (view options)
  (let* ((languages (maps:get 'languages view))
         (modules (flatten-modules languages))
         (index (render-index view options modules))
         (module-files (render-modules view options languages modules)))
    (lists:sort (lambda (left right) (< (element 1 left) (element 1 right)))
                (lists:append (list (tuple #b("index.html") index)
                              (tuple #b("ldoc.css") (ldoc-html-assets:css))
                              (tuple #b("ldoc.js") (ldoc-html-assets:js)))
                        module-files))))
(defun flatten-modules (languages)
  (lists:append (lists:map #'modules-of/1 languages)))
(defun modules-of (language)
  (lists:map (lambda (module) `#(,(maps:get 'name language) ,module)) (maps:get 'modules language)))
(defun render-index (view options modules)
  (html-binary
    (list (page-start (maps:get 'release view) options)
          (mobile-toolbar)
          #b("<div class=\"page-layout overview-layout\">")
          (navigation-panel (maps:get 'languages view) 'none)
          #b("<main id=\"main\" class=\"content\" tabindex=\"-1\"><article class=\"overview-content\">")
          (overview-content (maps:get 'overview options) modules)
          #b("</article></main></div>")
          (page-end))))
(defun overview-content (overview modules)
  (if (=:= overview #b())
      (list #b("<h1>API overview</h1><p>Browse the modules for this release.</p>")
            #b("<h2>Modules</h2>") (overview-module-links modules))
      (list (if (overview-has-heading? overview) #b() #b("<h1>API overview</h1>"))
            (render-markdown overview)
            #b("<h2>Modules</h2>")
            (overview-module-links modules))))
(defun overview-has-heading? (overview)
  (first-heading? (binary:split overview #b("\n") (list 'global))))
(defun first-heading? (lines)
  (case lines
    (() 'false)
    ((cons line rest)
     (if (=:= line #b()) (first-heading? rest) (overview-heading? line)))
    (_ 'false)))
(defun overview-heading? (line)
  (overview-heading-level line 0))
(defun overview-heading-level (line count)
  (if (andalso (< count 6)
               (andalso (> (byte_size line) count)
                        (=:= (binary:at line count) 35)))
      (overview-heading-level line (+ count 1))
      (andalso (> count 0)
               (andalso (< count 7)
                        (andalso (> (byte_size line) count)
                                 (=:= (binary:at line count) 32))))))
(defun render-modules (view options languages modules)
  (lists:map (lambda (item)
               (render-module-file view options item languages modules))
             modules))
(defun render-module-file (view options item languages modules)
  (let* ((module (element 2 item))
         (language (element 1 item))
         (filename (module-filename language (maps:get 'name module))))
    (tuple filename
      (html-binary
        (list (page-start (maps:get 'release view) options)
              (mobile-toolbar)
              #b("<div class=\"page-layout\">")
              (navigation-panel languages item)
              #b("<main id=\"main\" class=\"content\" tabindex=\"-1\"><article class=\"module-content\"><h1 class=\"module-title\">")
              (ldoc-markup:escape (maps:get 'name module))
              #b("</h1>")
              (render-doc (maps:get 'format module) (maps:get 'doc module)
                          options)
              (source-link module options)
              (render-definitions module options)
              #b("</article></main></div>")
              (page-end))))))
(defun html-binary (parts) (iolist_to_binary parts))
(defun page-start (release options)
  (list #b("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>")
        (ldoc-markup:escape (release-title release))
        #b(" · ldoc</title><link rel=\"stylesheet\" href=\"ldoc.css\"><script defer src=\"ldoc.js\"></script></head><body><a class=\"skip\" href=\"#main\">Skip to content</a><header class=\"top\"><span class=\"library\">")
        (ldoc-markup:escape (library-coordinate release))
        #b("</span>")
        (version-label release options)
        #b("<span class=\"brand-mark\">ldoc</span></header>")))
(defun version-label (release options)
  (let ((version (maps:get 'version release)))
    (if (=:= (maps:get 'version_index options) 'true)
        (list #b("<a class=\"version\" href=\"../index.html\" aria-label=\"Choose exact release ")
              (ldoc-markup:escape version)
              #b("\">")
              (ldoc-markup:escape version)
              #b("</a>"))
        (list #b("<span class=\"version\">")
              (ldoc-markup:escape version)
              #b("</span>")))))
(defun mobile-toolbar ()
  #b("<div class=\"mobile-toolbar\"><button class=\"menu-button\" data-menu-button hidden aria-expanded=\"false\" aria-controls=\"api-navigation\">☰ Open navigation</button><div class=\"mobile-strip\"></div></div>"))
(defun page-end () #b("</body></html>"))
(defun library-coordinate (release)
  (iolist_to_binary (list (maps:get 'namespace release) #b("/")
                          (maps:get 'package release))))
(defun release-title (release)
  (iolist_to_binary (list (library-coordinate release) #b(" ")
                          (maps:get 'version release))))
(defun filter-control ()
  #b("<div class=\"filter-control\"><label for=\"api-filter\" hidden>Filter API navigation</label><input id=\"api-filter\" class=\"filter\" data-filter hidden type=\"search\" autocomplete=\"off\"><button class=\"filter-clear\" data-filter-clear hidden type=\"button\">Clear filter</button><p class=\"status\" data-filter-status aria-live=\"polite\"></p></div>"))
(defun navigation-panel (languages current-item)
  (list #b("<nav id=\"api-navigation\" class=\"nav-panel\" data-navigation aria-label=\"API navigation\">")
        #b("<div class=\"nav-columns\"><div class=\"primary-nav\">")
        (filter-control)
        #b("<p class=\"nav-title\">Browse</p><ul class=\"nav-list\"><li data-filter-item><a href=\"index.html\"")
        (if (=:= current-item 'none) #b(" aria-current=\"page\"") #b())
        #b(">Overview</a></li></ul>")
        (navigation-languages languages current-item)
        #b("</div>")
        (if (=:= current-item 'none) #b()
            (navigation-definitions (element 2 current-item)))
        #b("</div></nav>")))
(defun navigation-languages (languages current-item)
  (lists:map (lambda (language)
               (list #b("<section class=\"language-group\"><h2 class=\"nav-title\">Language ")
                     (ldoc-markup:escape (maps:get 'name language))
                     #b("</h2><ul class=\"nav-list\">")
                     (navigation-language-modules language current-item)
                     #b("</ul></section>")))
             languages))
(defun navigation-language-modules (language current-item)
  (lists:map (lambda (module)
               (let* ((name (maps:get 'name module))
                      (language-name (maps:get 'name language))
                      (current (=:= current-item `#(,language-name ,module))))
                 (list #b("<li data-filter-item><a href=\"")
                       (module-filename language-name name)
                       #b("\"")
                       (if current #b(" aria-current=\"page\"") #b())
                       #b(">") (ldoc-markup:escape name) #b("</a></li>"))))
             (maps:get 'modules language)))
(defun navigation-definitions (module)
  (list #b("<section class=\"definition-nav\"><p class=\"nav-title\">Definitions</p><ul class=\"nav-list\">")
        (lists:map (lambda (definition)
                     (list #b("<li data-filter-item><a href=\"#")
                           (definition-id definition) #b("\">")
                           (ldoc-markup:escape (definition-label definition))
                           #b("</a></li>")))
                   (maps:get 'definitions module))
        #b("</ul></section>")))
(defun definition-label (definition)
  (iolist_to_binary
    (list (maps:get 'kind definition) #b(" ") (maps:get 'name definition)
          #b("/") (arity-text (maps:get 'arity definition)))))
(defun overview-module-links (modules)
  (list #b("<ul class=\"overview-modules\">")
        (lists:map (lambda (item)
                     (let ((module (element 2 item)))
                       (list #b("<li><a href=\"")
                             (module-filename (element 1 item)
                                              (maps:get 'name module))
                             #b("\">")
                             (ldoc-markup:escape (maps:get 'name module))
                             #b("</a></li>"))))
                   modules)
        #b("</ul>")))

(defun render-module-file-name (language module)
  (module-filename language module))
(defun module-filename (language module)
  (let ((digest (crypto:hash 'sha256
                            (iolist_to_binary
                             (list (uint32-bytes (byte_size language)) language
                                   (uint32-bytes (byte_size module)) module)))))
    (iolist_to_binary (list #b("m-") (uppercase-hex digest) #b(".html")))))
(defun uint32-bytes (value)
  (list (div value 16777216)
        (rem (div value 65536) 256)
        (rem (div value 256) 256)
        (rem value 256)))
(defun uppercase-hex (binary)
  (iolist_to_binary (lists:map (lambda (byte) (hex-byte byte)) (binary_to_list binary))))
(defun hex-byte (byte)
  (let ((digits #b("0123456789ABCDEF")))
    (list (binary:at digits (div byte 16)) (binary:at digits (rem byte 16)))))
(defun definition-id (definition)
  (iolist_to_binary (list #b("def-") (uppercase-hex (maps:get 'kind definition)) #b("-")
                          (uppercase-hex (maps:get 'name definition)) #b("-")
                          (arity-text (maps:get 'arity definition)))))
(defun render-definitions (module options)
  (lists:map (lambda (definition) (render-definition module definition options))
             (maps:get 'definitions module)))
(defun render-definition (module definition options)
  (list #b("<section class=\"definition\" id=\"")
        (definition-id definition)
        #b("\"><h2><a href=\"#")
        (definition-id definition)
        #b("\">") (ldoc-markup:escape (maps:get 'name definition))
        #b("/") (arity-text (maps:get 'arity definition))
        #b("</a><span class=\"kind\">")
        (ldoc-markup:escape (maps:get 'kind definition))
        #b("</span></h2>")
        (signatures (maps:get 'signatures definition))
        (optional-patterns definition)
        (render-doc (maps:get 'format module) (maps:get 'doc definition) options)
        (source-link definition options)
        #b("</section>")))
(defun signatures (items)
  (case items
    (() #b())
    (_ (lists:map #'signature-block/1 items))))
(defun signature-block (signature)
  (list #b("<pre class=\"signature\"><code>")
        (ldoc-markup:escape signature)
        #b("</code></pre>")))
(defun optional-patterns (definition)
  (case (maps:find 'patterns definition)
    ('error #b())
    (`#(ok ,value)
     (list #b("<p class=\"nav-title\">Patterns / guards</p><pre class=\"patterns\"><code>")
           (native-readable value)
           #b("</code></pre>")))))
(defun native-readable (value)
  (ldoc-markup:escape
    (unicode:characters_to_binary (lfe_io:print1 value) 'utf8 'utf8)))
(defun render-doc (format doc options)
  (case doc
    ('none #b("<p class=\"state\">No documentation supplied.</p>"))
    ('hidden #b("<p class=\"state\">Documentation is hidden.</p>"))
    (doc-map (when (is_map doc-map)) (render-doc-map format doc-map options))))
(defun render-doc-map (format doc options)
  (case (select-locale doc (maps:get 'locale options))
    ('none #b("<p class=\"state\">No documentation text is available.</p>"))
    (choice (render-doc-choice format choice))))
(defun render-doc-choice (format choice)
  (case choice
    (`#(,locale ,value)
     (case value
       (#b() #b("<p class=\"state\">Documentation text is empty.</p>"))
       (_ (case (ldoc-markup:render format value)
            (`#(ok ,html)
             (list #b("<div class=\"doc\"") (language-attribute locale)
                   #b(">") html #b("</div>")))))))))
(defun render-markdown (text)
  (case (ldoc-markup:render #b("text/markdown") text)
    (`#(ok ,html) html)))
(defun select-locale (doc locale)
  (case (maps:find locale doc)
    (`#(ok ,value) `#(,locale ,value))
    (_ (case (maps:find #b("und") doc)
         (`#(ok ,value) `#(#b("und") ,value))
         (_ (case (lists:sort (maps:keys doc))
              (() 'none)
              ((cons first _) `#(,first ,(maps:get first doc)))))))))
(defun language-attribute (locale)
  (if (safe-lang-tag? locale) (list #b(" lang=\"") (ldoc-markup:escape locale) #b("\"")) #b()))
(defun safe-lang-tag? (locale)
  (case (binary:split locale #b("-") (list 'global))
    ((cons primary ())
     (andalso (primary-language? primary)
              (not (=:= (string:lowercase (binary_to_list primary)) "und"))))
    ((cons primary (cons second ()))
     (andalso (primary-language? primary)
              (not (=:= (string:lowercase (binary_to_list primary)) "und"))
              (or (region? second) (script? second))))
    ((cons primary (cons script (cons region ())))
     (andalso (primary-language? primary)
              (not (=:= (string:lowercase (binary_to_list primary)) "und"))
              (script? script)
              (region? region)))
    (_ 'false)))
(defun primary-language? (part)
  (andalso (or (=:= (byte_size part) 2) (=:= (byte_size part) 3))
           (ascii-letters? part)))
(defun script? (part)
  (andalso (=:= (byte_size part) 4) (ascii-letters? part)))
(defun region? (part)
  (or (andalso (=:= (byte_size part) 2) (ascii-letters? part))
      (andalso (=:= (byte_size part) 3) (ascii-digits? part))))
(defun ascii-letters? (part)
  (ascii-letters-at? part 0))
(defun ascii-letters-at? (part index)
  (if (>= index (byte_size part)) 'true
      (let ((byte (binary:at part index)))
        (andalso (or (andalso (>= byte 65) (=< byte 90))
                     (andalso (>= byte 97) (=< byte 122)))
                 (ascii-letters-at? part (+ index 1))))))
(defun ascii-digits? (part)
  (ascii-digits-at? part 0))
(defun ascii-digits-at? (part index)
  (if (>= index (byte_size part)) 'true
      (let ((byte (binary:at part index)))
        (andalso (andalso (>= byte 48) (=< byte 57))
                 (ascii-digits-at? part (+ index 1))))))
(defun source-link (owner options)
  (case (maps:find 'source owner)
    ('error #b())
    (`#(ok ,source)
     (case (maps:get 'source_base options)
       ('none #b())
       (base (list #b("<p class=\"source\"><a href=\"")
                   (ldoc-markup:escape (source-url base source))
                   #b("\">Source</a></p>")))))))
(defun source-url (base source)
  (let* ((path (quote-path (maps:get 'path source)))
         (line (maps:get 'line source 'none)))
    (iolist_to_binary (list base path (case line ('none #b()) (number (when (is_integer number)) (list #b("#L") (erlang:integer_to_binary number))))))))
(defun quote-path (path)
  (join-path (binary:split path #b("/") (list 'global))))
(defun join-path (parts)
  (case parts
    (() #b())
    ((cons first ()) (quote-component first))
    ((cons first rest) (list (quote-component first) #b("/") (join-path rest)))))
(defun quote-component (component)
  (uri_string:quote component))
