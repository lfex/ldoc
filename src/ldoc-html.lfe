;;;; Pure deterministic static HTML rendering for selected analysis views.

(defmodule ldoc-html
  (export
   (render 1)
   (render 2)))

(defspec (render 1)
  ([(map)] (UNION (tuple 'ok (list)) (tuple 'error 'invalid_view))))
(defspec (render 2)
  ([(map) (map)] (UNION (tuple 'ok (list))
                        (tuple 'error (UNION 'invalid_options 'invalid_view)))))

(defun render (view)
  "Render VIEW with default options into sorted relative filename/byte pairs."
  (render view #m()))

(defun render (view options)
  "Validate options and the complete selected view, then return a pure HTML bundle."
  (case (validate-options options)
    ('false '#(error invalid_options))
    (`#(ok ,opts)
     (case (validate-view view)
       ('false '#(error invalid_view))
       (`#(ok ,canonical)
        `#(ok ,(bundle canonical opts)))))))

(defun validate-options (options)
  (if (andalso (is_map options)
               (andalso (all-keys? (maps:keys options) '(locale overview source_base))
                        (andalso (valid-locale? (maps:get 'locale options #b("en")))
                                 (valid-overview? (maps:get 'overview options #b())))))
      (case (maps:find 'source_base options)
        ('error `#(ok ,(canonical-options options)))
        (`#(ok ,base) (if (valid-source-base? base)
                          `#(ok ,(canonical-options options)) 'false)))
      'false))

(defun canonical-options (options)
  `#m(locale ,(maps:get 'locale options #b("en"))
      overview ,(maps:get 'overview options #b())
      source_base ,(maps:get 'source_base options 'none)))
(defun all-keys? (keys allowed)
  (case keys
    (() 'true)
    ((cons key rest) (andalso (lists:member key allowed) (all-keys? rest allowed)))
    (_ 'false)))
(defun valid-locale? (locale)
  (andalso (is_binary locale) (> (byte_size locale) 0) (valid-utf8? locale)))
(defun valid-overview? (overview)
  (andalso (is_binary overview) (valid-utf8? overview)))
(defun valid-utf8? (binary)
  (case (unicode:characters_to_binary binary 'utf8 'utf8)
    (value (when (is_binary value)) 'true)
    (_ 'false)))

(defun valid-source-base? (base)
  (andalso (is_binary base)
           (andalso (> (byte_size base) 0)
           (andalso (valid-utf8? base)
           (andalso (not (has-forbidden-uri-byte? base 0))
           (andalso (valid-percent-triplets? base 0)
                    (uri-structure? base)))))))
(defun has-forbidden-uri-byte? (base index)
  (if (>= index (byte_size base)) 'false
      (let ((c (binary:at base index)))
        (or (=< c 32) (=:= c 127) (=:= c 92)
            (has-forbidden-uri-byte? base (+ index 1))))))
(defun valid-percent-triplets? (base index)
  (if (>= index (byte_size base)) 'true
      (if (=:= (binary:at base index) 37)
          (andalso (< (+ index 2) (byte_size base))
                   (hex-digit? (binary:at base (+ index 1)))
                   (hex-digit? (binary:at base (+ index 2)))
                   (valid-percent-triplets? base (+ index 3)))
          (valid-percent-triplets? base (+ index 1)))))
(defun hex-digit? (c)
  (or (andalso (>= c 48) (=< c 57))
      (andalso (>= c 65) (=< c 70))
      (andalso (>= c 97) (=< c 102))))
(defun uri-structure? (base)
  (let ((parsed (uri_string:parse base)))
    (if (is_map parsed)
        (let* ((scheme (maps:get 'scheme parsed #b()))
               (host (maps:get 'host parsed #b()))
               (path (maps:get 'path parsed #b()))
               (port (maps:get 'port parsed 'absent))
               (scheme-lower (string:lowercase (binary_to_list scheme))))
          (lists:all (lambda (valid) valid)
                     (list (or (=:= scheme-lower "http") (=:= scheme-lower "https"))
                           (is_binary host) (> (byte_size host) 0)
                           (is_binary path) (ends-slash? path)
                           (not (maps:is_key 'userinfo parsed))
                           (not (maps:is_key 'query parsed))
                           (not (maps:is_key 'fragment parsed))
                           (valid-explicit-port? port)
                           (not (empty-explicit-port? base)))))
        'false)))
(defun valid-explicit-port? (port)
  (or (=:= port 'absent)
      (andalso (is_integer port) (andalso (>= port 0) (=< port 65535)))))
(defun empty-explicit-port? (base)
  (case (binary:split base #b("://"))
    ((cons _ tail)
     (case (binary:split (hd tail) #b("/"))
       ((cons authority _) (andalso (> (byte_size authority) 0)
                                    (=:= (binary:at authority (- (byte_size authority) 1)) 58)))
       (_ 'false)))
    (_ 'false)))
(defun ends-slash? (path)
  (andalso (> (byte_size path) 0) (=:= (binary:at path (- (byte_size path) 1)) 47)))

(defun validate-view (view)
  (if (andalso (is_map view)
               (andalso (=:= (lists:sort (maps:keys view)) '(languages release))
                        (andalso (valid-release (maps:get 'release view))
                                 (proper-list? (maps:get 'languages view)))))
      (let ((raw-languages (validated-languages (maps:get 'languages view))))
        (if (=:= raw-languages 'invalid)
            'false
            (let ((languages (lists:sort (lambda (a b) (< (maps:get 'name a) (maps:get 'name b))) raw-languages)))
              (if (andalso (not (=:= languages ()))
                           (unique-by languages #'language-name/1))
                  `#(ok ,(maps:from_list (list (tuple 'release (maps:get 'release view))
                                               (tuple 'languages languages))))
                  'false))))
      'false))
(defun valid-release (release)
  (andalso (is_map release)
           (andalso (=:= (lists:sort (maps:keys release)) '(namespace package version))
           (andalso (valid-nonempty-utf8? (maps:get 'namespace release))
           (andalso (valid-nonempty-utf8? (maps:get 'package release))
                    (valid-nonempty-utf8? (maps:get 'version release)))))))
(defun valid-nonempty-utf8? (value)
  (andalso (is_binary value) (andalso (> (byte_size value) 0) (valid-utf8? value))))
(defun proper-list? (value)
  (case value (() 'true) ((cons _ rest) (proper-list? rest)) (_ 'false)))
(defun unique-by (items keyfun)
  (unique-by items keyfun #m()))
(defun unique-by (items keyfun seen)
  (case items
    (() 'true)
    ((cons item rest)
     (let ((key (funcall keyfun item)))
       (if (maps:is_key key seen) 'false
           (unique-by rest keyfun (maps:put key 'true seen)))))
    (_ 'false)))
(defun language-name (language) (maps:get 'name language))
(defun canonical-languages (languages)
  (lists:sort (lambda (a b) (< (maps:get 'name a) (maps:get 'name b)))
              (validated-languages languages)))
(defun validated-languages (languages)
  (case languages
    (() ())
    ((cons lang rest)
     (case (validate-language lang)
       ('false 'invalid)
       (valid (let ((tail-values (validated-languages rest)))
                (if (=:= tail-values 'invalid) 'invalid (cons valid tail-values))))))
    (_ 'invalid)))
(defun validate-language (lang)
  (if (andalso (is_map lang)
               (andalso (=:= (lists:sort (maps:keys lang)) '(modules name))
               (andalso (valid-nonempty-utf8? (maps:get 'name lang))
                        (proper-list? (maps:get 'modules lang)))))
      (let ((modules (validated-modules (maps:get 'modules lang))))
        (if (andalso (not (=:= modules 'invalid)) (unique-by modules #'module-name/1))
            (maps:from_list (list (tuple 'name (maps:get 'name lang)) (tuple 'modules (lists:sort (lambda (a b) (< (maps:get 'name a) (maps:get 'name b))) modules))))
            'false))
      'false))
(defun module-name (module) (maps:get 'name module))
(defun validated-modules (modules)
  (case modules
    (() ())
    ((cons module rest)
     (case (validate-module module)
       ('false 'invalid)
       (valid (let ((tail-values (validated-modules rest)))
                (if (=:= tail-values 'invalid) 'invalid (cons valid tail-values))))))
    (_ 'invalid)))
(defun validate-module (module)
  (if (is_map module)
      (if (andalso (required-optional-keys? module '(name format doc definitions) '(source))
                   (andalso (valid-nonempty-utf8? (maps:get 'name module))
                   (andalso (valid-nonempty-utf8? (maps:get 'format module))
                   (andalso (valid-doc (maps:get 'doc module))
                   (andalso (proper-list? (maps:get 'definitions module))
                            (valid-source (maps:get 'source module 'none)))))))
          (let ((defs (validated-definitions (maps:get 'definitions module))))
            (if (andalso (not (=:= defs 'invalid))
                         (unique-by defs #'definition-identity/1)
                         (or (not (=:= (maps:get 'doc module) 'hidden))
                             (andalso (=:= defs ()) (not (maps:is_key 'source module)))))
                (maps:put 'definitions
                          (lists:sort (lambda (a b) (< (definition-identity a) (definition-identity b))) defs)
                          module)
                'false))
          'false)
      'false))
(defun required-optional-keys? (map required optional)
  (andalso (lists:all (lambda (key) (maps:is_key key map)) required)
           (all-keys? (maps:keys map) (lists:append required optional))))
(defun valid-doc (doc)
  (case doc
    ('none 'true)
    ('hidden 'true)
    (doc-map (when (is_map doc-map)) (valid-doc-map (maps:to_list doc-map)))
    (_ 'false)))
(defun valid-doc-map (pairs)
  (case pairs
    (() 'true)
    ((cons pair rest)
     (case pair
       ((tuple key value)
        (andalso (is_binary key) (andalso (valid-utf8? key) (andalso (valid-doc-value value) (valid-doc-map rest)))))
       (_ 'false)))
    (_ 'false)))
(defun valid-doc-value (value)
  (case value
    (binary (when (is_binary binary)) (valid-utf8? binary))
    (() 'true)
    ((cons head tail) (andalso (valid-doc-value head) (valid-doc-value tail)))
    ((tuple tag attrs children)
     (andalso (=:= (tuple_size value) 3)
              (andalso (is_atom tag)
                       (andalso (valid-edoc-attrs attrs)
                                (valid-doc-value children)))))
    (tuple 'false)
    (_ 'true)))
(defun valid-edoc-attrs (attrs)
  (case attrs
    (() 'true)
    ((cons item rest)
     (case item
       ((tuple key value)
        (andalso (is_atom key)
                 (andalso (is_binary value)
                          (andalso (valid-utf8? value) (valid-edoc-attrs rest)))))
       (_ 'false)))
    (_ 'false)))
(defun valid-source (source)
  (case source
    ('none 'true)
    (source-map (when (is_map source-map)) (andalso (all-keys? (maps:keys source-map) '(path line))
                    (andalso (maps:is_key 'path source-map)
                    (andalso (safe-relative-path? (maps:get 'path source-map))
                    (case (maps:find 'line source-map)
                      ('error 'true)
                      (`#(ok ,line) (andalso (is_integer line) (> line 0))))))))
    (_ 'false)))
(defun has-control? (value index)
  (if (>= index (byte_size value)) 'false
      (let ((c (binary:at value index)))
        (or (< c 32) (=:= c 127) (has-control? value (+ index 1))))))
(defun safe-relative-path? (path)
  (andalso (is_binary path)
           (andalso (> (byte_size path) 0)
           (andalso (valid-utf8? path)
           (andalso (not (or (=:= (binary:at path 0) 47) (has-control? path 0)))
                    (proper-path-components? (binary:split path #b("/") (list 'global))))))))
(defun proper-path-components? (parts)
  (case parts
    (() 'true)
    ((cons part rest)
     (andalso (> (byte_size part) 0) (andalso (not (=:= part #b("."))) (andalso (not (=:= part #b(".."))) (proper-path-components? rest)))))
    (_ 'false)))
(defun validated-definitions (definitions)
  (case definitions
    (() ())
    ((cons definition rest)
     (case (validate-definition definition)
       ('false 'invalid)
       (valid (let ((tail-values (validated-definitions rest)))
                (if (=:= tail-values 'invalid) 'invalid (cons valid tail-values))))))
    (_ 'invalid)))
(defun validate-definition (definition)
  (if (andalso (is_map definition)
               (andalso (required-optional-keys? definition '(kind name arity signatures doc) '(patterns source))
               (andalso (valid-nonempty-utf8? (maps:get 'kind definition))
               (andalso (valid-nonempty-utf8? (maps:get 'name definition))
               (andalso (valid-arity (maps:get 'arity definition))
               (andalso (proper-list? (maps:get 'signatures definition))
               (andalso (lists:all #'valid-utf8?/1 (maps:get 'signatures definition))
               (andalso (valid-doc (maps:get 'doc definition))
               (andalso (valid-source (maps:get 'source definition 'none))
                        (valid-readable-value (maps:get 'patterns definition 'none)))))))))))
      definition 'false))
(defun valid-arity (arity)
  (or (=:= arity 'unknown) (andalso (is_integer arity) (>= arity 0))))
(defun valid-readable-value (value)
  (case value ('none 'true) ((cons _ _) (proper-list? value)) (_ 'false)))
(defun definition-identity (definition)
  `#(,(maps:get 'kind definition) ,(maps:get 'name definition) ,(maps:get 'arity definition)))
(defun arity-key (arity)
  (case arity ('unknown #b("unknown")) (number (when (is_integer number)) (erlang:integer_to_binary number))))

(defun bundle (view options)
  (let* ((languages (maps:get 'languages view))
         (modules (flatten-modules languages))
         (index (render-index view options modules))
         (module-files (render-modules view options languages modules)))
    (lists:sort (lambda (left right) (< (element 1 left) (element 1 right)))
                (lists:append (list (tuple #b("index.html") index)
                              (tuple #b("ldoc.css") (ldoc-html-assets:css))
                              (tuple #b("ldoc.js") (ldoc-html-assets:js)))
                        module-files))))
(defun flatten-modules (languages)
  (lists:append (lists:map #'modules-of/1 languages)))
(defun modules-of (language)
  (lists:map (lambda (module) `#(,(maps:get 'name language) ,module)) (maps:get 'modules language)))
(defun render-index (view options modules)
  (html-binary (list (page-start (release-title (maps:get 'release view)))
                     #b("<div class=\"layout overview\"><nav class=\"desktop-nav\" aria-label=\"API navigation\">")
                     (filter-control #b("api-filter"))
                     (navigation-modules modules)
                     #b("</nav>") (mobile-navigation modules)
                     #b("<main id=\"main\" class=\"content\"><article class=\"overview-content\"><h1>")
                     (ldoc-markup:escape (release-title (maps:get 'release view)))
                     #b("</h1>") (render-doc #b("text/markdown") (maps:get 'overview options) options)
                     #b("<h2>Modules</h2>") (overview-module-links modules)
                     #b("</article></main></div>") (page-end))))
(defun render-modules (view options languages modules)
  (lists:map (lambda (item) (render-module-file view options item modules)) modules))
(defun render-module-file (view options item modules)
  (let* ((module (element 2 item))
         (language (element 1 item))
         (filename (module-filename language (maps:get 'name module))))
    (tuple filename (html-binary (list (page-start (release-title (maps:get 'release view)))
                                 #b("<div class=\"layout\"><nav class=\"desktop-nav\" aria-label=\"Modules\">")
                                 (filter-control #b("api-filter")) (navigation-modules modules)
                                 #b("</nav><nav class=\"api-nav desktop-nav\" aria-label=\"Definitions\">")
                                 (navigation-definitions module) #b("</nav>")
                                 (mobile-navigation modules)
                                 #b("<main id=\"main\" class=\"content\"><article class=\"module-content\"><h1 class=\"module-title\">")
                                 (ldoc-markup:escape (maps:get 'name module)) #b("</h1>")
                                 (module-doc module options)
                                 (source-link (maps:get 'source module 'none) options)
                                 (render-definitions module options)
                                 #b("</article></main></div>") (page-end))))))
(defun html-binary (parts)
  (iolist_to_binary parts))
(defun page-start (release)
  (list #b("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>")
        (ldoc-markup:escape release) #b(" · LDOC</title><link rel=\"stylesheet\" href=\"ldoc.css\"><script defer src=\"ldoc.js\"></script></head><body><a class=\"skip\" href=\"#main\">Skip to content</a><header class=\"top\"><a class=\"brand\" href=\"index.html\">LDOC</a><span class=\"version\">") (ldoc-markup:escape release) #b("</span></header>")))
(defun page-end () #b("</body></html>"))
(defun release-title (release)
  (iolist_to_binary (list (maps:get 'namespace release) #b("/") (maps:get 'package release) #b(" ") (maps:get 'version release))))
(defun filter-control (id)
  (list #b("<label for=\"") id #b("\">Filter API navigation</label><input id=\"") id #b("\" class=\"filter\" data-filter hidden type=\"search\" autocomplete=\"off\"><p class=\"status\" data-filter-status aria-live=\"polite\"></p>")))
(defun navigation-modules (modules)
  (list #b("<p class=\"nav-title\">Modules</p><ul class=\"nav-list\">")
        (lists:map (lambda (item)
                     (let ((module (element 2 item)))
                       (list #b("<li data-filter-item><a href=\"")
                             (module-filename (element 1 item) (maps:get 'name module))
                             #b("\">")
                             (ldoc-markup:escape (maps:get 'name module))
                             #b("</a></li>"))))
                   modules)
        #b("</ul>")))
(defun navigation-definitions (module)
  (list #b("<p class=\"nav-title\">Definitions</p><ul class=\"nav-list\">")
        (lists:map (lambda (definition)
                     (list #b("<li data-filter-item><a href=\"#")
                           (definition-id definition)
                           #b("\">")
                           (ldoc-markup:escape (maps:get 'name definition))
                           #b("/")
                           (arity-text (maps:get 'arity definition))
                           #b("</a></li>")))
                   (maps:get 'definitions module))
        #b("</ul>")))
(defun mobile-navigation (modules)
  (list #b("<div class=\"mobile-bar\"><button class=\"menu-button\" data-menu-button aria-expanded=\"false\" aria-controls=\"mobile-nav\">☰ Tap for navigation</button></div><div class=\"mobile-strip\"></div><nav id=\"mobile-nav\" class=\"mobile-nav\" data-mobile-nav aria-label=\"Mobile API navigation\">")
        (filter-control #b("mobile-api-filter")) (navigation-modules modules) #b("</nav>")))
(defun overview-module-links (modules)
  (list #b("<ul>") (lists:map (lambda (item)
                              (let ((module (element 2 item)))
                                (list #b("<li><a href=\"") (module-filename (element 1 item) (maps:get 'name module)) #b("\">")
                                      (ldoc-markup:escape (maps:get 'name module)) #b("</a></li>")))) modules) #b("</ul>")))
(defun render-module-file-name (language module)
  (module-filename language module))
(defun module-filename (language module)
  (let ((digest (crypto:hash 'sha256
                            (iolist_to_binary
                             (list (uint32-bytes (byte_size language)) language
                                   (uint32-bytes (byte_size module)) module)))))
    (iolist_to_binary (list #b("m-") (uppercase-hex digest) #b(".html")))))
(defun uint32-bytes (value)
  (list (div value 16777216)
        (rem (div value 65536) 256)
        (rem (div value 256) 256)
        (rem value 256)))
(defun uppercase-hex (binary)
  (iolist_to_binary (lists:map (lambda (byte) (hex-byte byte)) (binary_to_list binary))))
(defun hex-byte (byte)
  (let ((digits #b("0123456789ABCDEF")))
    (list (binary:at digits (div byte 16)) (binary:at digits (rem byte 16)))))
(defun definition-id (definition)
  (iolist_to_binary (list #b("def-") (uppercase-hex (maps:get 'kind definition)) #b("-")
                          (uppercase-hex (maps:get 'name definition)) #b("-")
                          (arity-text (maps:get 'arity definition)))))
(defun arity-text (arity)
  (case arity ('unknown #b("unknown")) (number (when (is_integer number)) (erlang:integer_to_binary number))))

(defun module-doc (module options)
  (render-doc (maps:get 'format module) (maps:get 'doc module) options))
(defun render-definitions (module options)
  (lists:map (lambda (definition) (render-definition module definition options))
             (maps:get 'definitions module)))
(defun render-definition (module definition options)
  (let ((doc (maps:get 'doc definition)))
    (list #b("<section class=\"definition\" id=\"") (definition-id definition) #b("\"><h2><a href=\"#")
          (definition-id definition) #b("\">") (ldoc-markup:escape (maps:get 'name definition)) #b("/")
          (arity-text (maps:get 'arity definition)) #b("</a><span class=\"kind\">")
          (ldoc-markup:escape (maps:get 'kind definition)) #b("</span></h2>")
          (signatures (maps:get 'signatures definition))
          (patterns (maps:get 'patterns definition 'none))
          (render-doc (maps:get 'format module) doc options)
          (source-link (maps:get 'source definition 'none) options)
          #b("</section>"))))
(defun signatures (items)
  (case items
    (() #b())
    (_ (list #b("<pre class=\"signatures\"><code>")
             (lists:map (lambda (line) (list (ldoc-markup:escape line) #b("\n"))) items)
             #b("</code></pre>")))))
(defun patterns (value)
  (case value
    ('none #b())
    (_ (list #b("<p class=\"nav-title\">Patterns / guards</p><pre class=\"patterns\"><code>")
             (ldoc-markup:escape (unicode:characters_to_binary (lfe_io:prettyprint1 value -1) 'utf8 'utf8))
             #b("</code></pre>")))))
(defun render-doc (format doc options)
  (case doc
    ('none #b("<p class=\"state\">No documentation supplied.</p>"))
    ('hidden #b("<p class=\"state\">Documentation is hidden.</p>"))
    (doc-map (when (is_map doc-map)) (render-doc-map format doc-map options))
    (_ #b())))
(defun render-doc-map (format doc options)
  (case (select-locale doc (maps:get 'locale options))
    ('none #b("<p class=\"state\">No documentation text is available.</p>"))
    (choice (render-doc-choice format choice))))
(defun render-doc-choice (format choice)
  (case choice
    (`#(,locale ,value)
     (case value
       (#b() #b("<p class=\"state\">Documentation text is empty.</p>"))
       (other
        (case (ldoc-markup:render format value)
          (`#(ok ,html)
           (list #b("<div class=\"doc\"") (language-attribute locale) #b(">") html #b("</div>")))
          (fallback #b("<p class=\"state\">Documentation is unavailable.</p>"))))))
    (other #b("<p class=\"state\">Documentation is unavailable.</p>"))))
(defun select-locale (doc locale)
  (case (maps:find locale doc)
    (`#(ok ,value) `#(,locale ,value))
    (_ (case (maps:find #b("und") doc)
         (`#(ok ,value) `#(#b("und") ,value))
         (_ (case (lists:sort (maps:keys doc))
              (() 'none)
              ((cons first _) `#(,first ,(maps:get first doc)))))))))
(defun language-attribute (locale)
  (if (safe-lang-tag? locale) (list #b(" lang=\"") (ldoc-markup:escape locale) #b("\"")) #b()))
(defun safe-lang-tag? (locale)
  (andalso (> (byte_size locale) 0) (not (=:= locale #b("und")))
           (lists:all (lambda (c) (or (andalso (>= c 65) (=< c 90))
                                      (andalso (>= c 97) (=< c 122))
                                      (=:= c 45) (andalso (>= c 48) (=< c 57))))
                      (binary_to_list locale))))
(defun source-link (source options)
  (case source
    ('none #b())
    (_ (case (maps:find 'source_base options)
         ('error #b())
         (`#(ok ,base)
          (if (=:= base 'none)
              #b()
              (let ((url (source-url base source)))
                (list #b("<p class=\"source\"><a href=\"")
                      (ldoc-markup:escape url)
                      #b("\">Source</a></p>")))))))))
(defun source-url (base source)
  (let* ((path (quote-path (maps:get 'path source)))
         (line (maps:get 'line source 'none)))
    (iolist_to_binary (list base path (case line ('none #b()) (number (when (is_integer number)) (list #b("#L") (erlang:integer_to_binary number))))))))
(defun quote-path (path)
  (join-path (binary:split path #b("/") (list 'global))))
(defun join-path (parts)
  (case parts
    (() #b())
    ((cons first ()) (quote-component first))
    ((cons first rest) (iolist_to_binary (list (quote-component first) #b("/") (join-path rest))))))
(defun quote-component (component)
  (uri_string:quote component))
